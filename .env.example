# PUBLIC : injecté au BUILD. Rebuild nécessaire après changement.
PUBLIC_BRAND_NAME=MorphAI
PUBLIC_SITE_MODE=preproduction
PUBLIC_LEGAL_VALIDATED=false
PUBLIC_SITE_URL=
PUBLIC_CONTACT_EMAIL=
PUBLIC_BOOKING_URL=
PUBLIC_GITHUB_URL=

# SERVEUR UNIQUEMENT : injecté au runtime, jamais exposé au navigateur.
# Trois verrous : PUBLIC_SITE_MODE=production, PUBLIC_LEGAL_VALIDATED=true,
# CONTACT_ENABLED=true. Par défaut aucune collecte et aucun appel PostgreSQL.
CONTACT_ENABLED=false
DATABASE_URL=
# true avec PostgreSQL TLS + certificat valide ; false sur réseau privé approprié.
CONTACT_DB_SSL=false
# Générer localement une valeur aléatoire d’au moins 32 caractères.
CONTACT_HASH_SECRET=
# Origines EXACTES séparées par virgule, sans slash final. Aucune déduction du Host.
CONTACT_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
CONTACT_RETENTION_MONTHS=12
# 0 = ignorer X-Forwarded-For. N’augmenter qu’après validation du proxy ingress.
CONTACT_TRUSTED_PROXY_HOPS=0

# Un seul fournisseur transactionnel : Resend. Rien n’est envoyé sans ces valeurs.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Railway fournit PORT ; start écoute 0.0.0.0 par défaut.
HOST=0.0.0.0
PORT=4321
