---
interface Props {
  diagonal?: boolean;
  class?: string;
}
const { diagonal = true, class: className = '' } = Astro.props;
---

<svg
  class:list={['arrow-icon', className]}
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
>
  <path
    d={diagonal ? 'M5 19 19 5M5 5h14v14' : 'M4 12h16m-6-6 6 6-6 6'}
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
