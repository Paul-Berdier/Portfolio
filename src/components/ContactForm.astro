---
import { randomUUID } from 'node:crypto';
import { contactOptions } from '../i18n/contact';
import { getBrand, localeFromPath, localizePath, translate, type Locale } from '../i18n';

interface Props {
  enabled: boolean;
  retentionMonths: number;
  selectedNeed?: keyof typeof contactOptions.fr.needs;
  locale?: Locale;
}
const {
  enabled,
  retentionMonths,
  selectedNeed,
  locale = localeFromPath(Astro.url.pathname),
} = Astro.props;
const { needs, budgets, deadlines } = contactOptions[locale];
const brand = getBrand(locale);
const t = (fr: string, en: string, es: string) => translate(locale, fr, en, es);
const key = randomUUID();
---

<form
  class="contact-form"
  method="post"
  action={locale === 'fr' ? '/api/contact' : `/api/contact?lang=${locale}`}
  data-contact-form
  data-contact-locale={locale}
  data-enabled={String(enabled)}
  aria-describedby="contact-privacy"
>
  <input type="hidden" name="idempotencyKey" value={key} />
  <div class="form-trap" aria-hidden="true">
    <label for="contact-website">
      {t(
        'Votre site internet (laisser vide)',
        'Your website (leave blank)',
        'Tu sitio web (déjalo vacío)',
      )}
    </label>
    <input id="contact-website" name="website" autocomplete="off" tabindex="-1" />
  </div>
  <fieldset disabled={!enabled}>
    <legend class="form-legend">
      <span>01</span>{' '}
      {t('Faisons connaissance.', 'Let’s get to know each other.', 'Empecemos por conocernos.')}
    </legend>
    <p class="form-help">
      {t(
        'Les champs marqués d’un astérisque sont nécessaires. Les autres sont facultatifs.',
        'Fields marked with an asterisk are required. All others are optional.',
        'Los campos marcados con un asterisco son obligatorios. Los demás son opcionales.',
      )}
    </p>
    <div class="form-grid">
      <div class="field">
        <label for="contact-name">
          {t('Votre nom', 'Your name', 'Tu nombre')} <span aria-hidden="true">*</span>
        </label>
        <input
          id="contact-name"
          name="name"
          autocomplete="name"
          required
          minlength="2"
          maxlength="100"
          placeholder={t('Prénom et nom', 'First and last name', 'Nombre y apellidos')}
          aria-describedby="error-name"
        />
        <p class="field-error" id="error-name" data-error-for="name" hidden></p>
      </div>
      <div class="field">
        <label for="contact-email">
          {t('Votre email', 'Your email', 'Tu correo electrónico')}{' '}
          <span aria-hidden="true">*</span>
        </label>
        <input
          id="contact-email"
          name="email"
          type="email"
          autocomplete="email"
          required
          maxlength="254"
          placeholder={t('vous@entreprise.fr', 'you@company.com', 'tu@empresa.es')}
          aria-describedby="error-email"
        />
        <p class="field-error" id="error-email" data-error-for="email" hidden></p>
      </div>
      <div class="field">
        <label for="contact-company">
          {t('Entreprise', 'Company', 'Empresa')}{' '}
          <span class="optional">{t('facultatif', 'optional', 'opcional')}</span>
        </label>
        <input
          id="contact-company"
          name="company"
          autocomplete="organization"
          maxlength="150"
          placeholder={t('Votre structure', 'Your organisation', 'Tu organización')}
          aria-describedby="error-company"
        />
        <p class="field-error" id="error-company" data-error-for="company" hidden></p>
      </div>
      <div class="field">
        <label for="contact-phone">
          {t('Téléphone', 'Phone', 'Teléfono')}{' '}
          <span class="optional">{t('facultatif', 'optional', 'opcional')}</span>
        </label>
        <input
          id="contact-phone"
          name="phone"
          type="tel"
          autocomplete="tel"
          maxlength="40"
          placeholder={t(
            'Un numéro pour échanger',
            'A number to reach you on',
            'Un número para hablar contigo',
          )}
          aria-describedby="error-phone"
        />
        <p class="field-error" id="error-phone" data-error-for="phone" hidden></p>
      </div>
    </div>
    <div class="form-divider"></div>
    <h2 class="form-legend">
      <span>02</span>{' '}
      {t('Ce que vous avez en tête.', 'What you have in mind.', 'Lo que tienes en mente.')}
    </h2>
    <div class="form-grid">
      <div class="field field-wide">
        <label for="contact-need">
          {t('Votre besoin', 'Your project', 'Tu proyecto')} <span aria-hidden="true">*</span>
        </label>
        <select id="contact-need" name="need" required aria-describedby="error-need">
          <option value="" selected={!selectedNeed} disabled>
            {t(
              'Quel sujet voulez-vous faire avancer ?',
              'What would you like to work on?',
              '¿Qué te gustaría hacer avanzar?',
            )}
          </option>
          {Object.entries(needs).map(([value, label]) => (
            <option value={value} selected={value === selectedNeed}>
              {label}
            </option>
          ))}
        </select>
        <p class="field-error" id="error-need" data-error-for="need" hidden></p>
      </div>
      <div class="field">
        <label for="contact-budget">
          {t('Budget indicatif', 'Estimated budget', 'Presupuesto orientativo')}{' '}
          <span aria-hidden="true">*</span>
        </label>
        <select id="contact-budget" name="budget" required aria-describedby="error-budget">
          {Object.entries(budgets).map(([value, label]) => (
            <option value={value}>{label}</option>
          ))}
        </select>
        <p class="field-error" id="error-budget" data-error-for="budget" hidden></p>
      </div>
      <div class="field">
        <label for="contact-deadline">
          {t('Échéance', 'Timeframe', 'Plazo')} <span aria-hidden="true">*</span>
        </label>
        <select id="contact-deadline" name="deadline" required aria-describedby="error-deadline">
          {Object.entries(deadlines).map(([value, label]) => (
            <option value={value}>{label}</option>
          ))}
        </select>
        <p class="field-error" id="error-deadline" data-error-for="deadline" hidden></p>
      </div>
      <div class="field field-wide">
        <label for="contact-message">
          {t('Parlez-moi de votre projet', 'Tell me about your project', 'Cuéntame tu proyecto')}{' '}
          <span aria-hidden="true">*</span>
        </label>
        <textarea
          id="contact-message"
          name="message"
          rows="6"
          required
          minlength="20"
          maxlength="5000"
          placeholder={t(
            'Le contexte, ce qui vous bloque aujourd’hui, ce que vous aimeriez rendre possible…',
            'The context, what’s holding you back today, and what you’d like to make possible…',
            'El contexto, lo que te frena hoy y lo que te gustaría hacer posible…',
          )}
          aria-describedby="message-hint error-message"
        ></textarea>
        <p class="field-hint" id="message-hint">
          {t(
            '20 à 5 000 caractères. Ne partagez pas de mot de passe ni de donnée confidentielle.',
            '20–5,000 characters. Do not share passwords or confidential information.',
            'De 20 a 5.000 caracteres. No compartas contraseñas ni datos confidenciales.',
          )}
        </p>
        <p class="field-error" id="error-message" data-error-for="message" hidden></p>
      </div>
    </div>
    <div class="form-submit">
      <button class="button button-primary" type="submit" data-submit>
        <span data-submit-label>
          {t('Parler de mon projet', 'Discuss my project', 'Hablar de mi proyecto')}
        </span>
        <span aria-hidden="true">↗</span>
      </button>
      <span class="submit-note">
        {t('Un premier échange.', 'A first conversation.', 'Una primera conversación.')}
        <br />
        {t(
          'Un besoin à clarifier, ensemble.',
          'A need to explore, together.',
          'Una necesidad que concretar juntos.',
        )}
      </span>
    </div>
  </fieldset>
  <p
    class="form-status"
    data-contact-status
    role="status"
    aria-live="polite"
    aria-atomic="true"
    tabindex="-1"
  ></p>
  <p class="privacy-note" id="contact-privacy">
    {brand.owner}{' '}
    {t(
      'utilise ces informations uniquement pour examiner votre demande et y répondre, dans le cadre de démarches précontractuelles à votre initiative. Conservation prévue :',
      'uses this information only to review and respond to your enquiry, as part of steps you request before entering into a contract. Planned retention:',
      'utiliza esta información únicamente para estudiar tu solicitud y responderte, en el marco de medidas precontractuales a petición tuya. Conservación prevista:',
    )}{' '}
    {retentionMonths}{' '}
    {t(
      'mois après la réception, sauf obligation légale applicable. Aucun abonnement à une newsletter.',
      'months after receipt, unless a legal obligation applies. No newsletter subscription.',
      'meses desde la recepción, salvo obligación legal aplicable. Sin suscripción a boletines.',
    )}{' '}
    <a href={localizePath('/confidentialite', locale)}>
      {t(
        'Détails du traitement et exercice de vos droits',
        'How your data is used and how to exercise your rights',
        'Detalles del tratamiento y ejercicio de tus derechos',
      )}
    </a>
    .
  </p>
  <noscript>
    <p class="form-help">
      {t(
        'Ce formulaire fonctionne aussi sans JavaScript lorsque la collecte est ouverte. Le résultat de l’envoi s’affichera sur une nouvelle page.',
        'This form also works without JavaScript when submissions are open. The result will appear on a new page.',
        'Este formulario también funciona sin JavaScript cuando se admiten solicitudes. El resultado se mostrará en una nueva página.',
      )}
    </p>
  </noscript>
</form>
<style>
  .contact-form {
    min-width: 0;
  }
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .form-legend {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    font-size: clamp(1.2rem, 2vw, 1.65rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    padding: 0;
    margin: 0 0 1.1rem;
  }
  .form-legend span {
    color: var(--accent);
    font: 400 0.7rem monospace;
    letter-spacing: 0.03em;
  }
  .form-help {
    color: var(--muted);
    font-size: 0.8rem;
    margin: 0 0 1.8rem;
  }
  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 1.2rem;
  }
  .field-wide {
    grid-column: 1 / -1;
  }
  .field {
    min-width: 0;
  }
  label {
    display: block;
    font-size: 0.82rem;
    margin-bottom: 0.65rem;
  }
  label > span:not(.optional) {
    color: var(--accent);
  }
  .optional {
    color: var(--muted);
    font-size: 0.7rem;
    margin-left: 0.35rem;
  }
  input:not([type='hidden']),
  select,
  textarea {
    display: block;
    width: 100%;
    min-width: 0;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--border-control);
    border-radius: 8px;
    padding: 0.95rem 1rem;
    font: inherit;
    font-size: 0.88rem;
    transition:
      border-color 0.2s,
      background 0.2s;
  }
  input::placeholder,
  textarea::placeholder {
    color: var(--muted);
    opacity: 1;
  }
  textarea {
    resize: vertical;
    min-height: 10rem;
  }
  select {
    padding-right: 0.8rem;
    cursor: pointer;
  }
  input:focus-visible,
  textarea:focus-visible,
  select:focus-visible {
    border-color: var(--focus);
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }
  [aria-invalid='true'] {
    border-color: var(--error) !important;
  }
  fieldset:disabled input,
  fieldset:disabled textarea,
  fieldset:disabled select {
    cursor: not-allowed;
  }
  fieldset:disabled .button {
    opacity: 0.65;
    cursor: not-allowed;
  }
  .field-hint {
    font-size: 0.72rem;
    color: var(--muted);
    margin-top: 0.55rem;
    line-height: 1.6;
  }
  .field-error {
    color: var(--error);
    font-size: 0.78rem;
    margin: 0.6rem 0 0;
  }
  .form-divider {
    height: 1px;
    background: var(--line);
    margin: 2.5rem 0;
  }
  .form-submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .submit-note {
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .form-status {
    min-height: 1.5em;
    font-size: 0.95rem;
    margin: 1.5rem 0 0;
    line-height: 1.6;
  }
  .form-status[data-state='error'] {
    color: var(--error);
  }
  .form-status[data-state='success'] {
    color: var(--success);
    padding: 1.25rem;
    border: 1px solid var(--success-line);
    border-radius: 8px;
    background: var(--success-soft);
  }
  .privacy-note {
    font-size: 0.72rem;
    line-height: 1.8;
    color: var(--muted);
    margin-top: 1rem;
  }
  .privacy-note a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .form-trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  @media (max-width: 580px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
    .form-submit {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }
    input:not([type='hidden']),
    select,
    textarea {
      font-size: 1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    input,
    textarea,
    select {
      transition: none !important;
    }
  }
  :global(html[data-motion='off']) input,
  :global(html[data-motion='off']) textarea,
  :global(html[data-motion='off']) select {
    transition: none;
  }
</style>
