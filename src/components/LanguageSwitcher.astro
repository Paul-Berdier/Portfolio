---
import { alternatePaths, localeFromPath, locales, localizePath } from '../i18n';
import { ui } from '../i18n/ui';
const locale = localeFromPath(Astro.url.pathname);
const paths = alternatePaths(Astro.url.pathname);
const names = { fr: 'Français', en: 'English', es: 'Español' };
---

<nav class="language-switcher" aria-label={ui(locale, 'language')} data-language-switcher>
  {locales.map((language) => (
    <a
      href={(paths?.[language] ?? localizePath('/', language)) + Astro.url.search}
      lang={language}
      hreflang={language}
      aria-label={names[language]}
      aria-current={locale === language ? 'true' : undefined}
      data-language={language}
    >
      {language.toUpperCase()}
    </a>
  ))}
</nav>
<style>
  .language-switcher {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: 2px;
    border: 1px solid var(--line);
    border-radius: 7px;
    padding: 3px;
  }
  a {
    display: grid;
    place-items: center;
    min-width: 30px;
    min-height: 40px;
    font-size: 12px;
    font-weight: 600;
    color: var(--muted);
    border-radius: 4px;
  }
  a:hover {
    background: var(--surface-hover);
    color: var(--ink);
  }
  a[aria-current] {
    background: var(--surface-hover);
    color: var(--accent);
  }
  @media (max-width: 760px) {
    a {
      min-width: 29px;
      min-height: 40px;
      font-size: 12px;
    }
  }
</style>

<script>
  // One module-scoped listener survives Astro navigations; no listener per logo/page instance.
  function syncLanguageHash() {
    document.querySelectorAll<HTMLAnchorElement>('[data-language-switcher] a').forEach((link) => {
      const url = new URL(link.href);
      url.search = location.search;
      url.hash = location.hash;
      link.href = url.href;
    });
  }
  window.addEventListener('hashchange', syncLanguageHash);
</script>
