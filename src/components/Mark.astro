---
import { symbolMarkup } from '../brand/ribbon.mjs';
interface Props {
  class?: string;
  variant?: 'color' | 'white' | 'dark';
  small?: boolean;
}
const { class: className = '', variant = 'color', small = true } = Astro.props;
const id = `ribbon-${crypto.randomUUID()}`;
---

<svg
  class:list={['brand-mark', className]}
  width="48"
  height="26"
  viewBox={small ? '0 -12 480 252' : '0 0 480 240'}
  data-mark="ribbon"
  aria-hidden="true"
>
  <g
    transform={small ? 'translate(0 -14.4) scale(1 1.12)' : undefined}
    set:html={symbolMarkup(id, { variant, small })}
  />
</svg>
