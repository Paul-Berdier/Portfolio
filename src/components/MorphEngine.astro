---
import BrandAnimation from './BrandAnimation.astro';
import ServiceVisual from './ServiceVisual.astro';
import { engineModes } from '../config/engine';
---

<div class="morph-engine" data-engine data-state="brand">
  <div class="engine-meta" aria-hidden="true">
    <span>
      <i />
      MORPH ENGINE
    </span>
    <span>UNE MATIÈRE · CINQ FORMES</span>
  </div>
  <div class="engine-stage">
    <BrandAnimation variant="hero" canvas />
    <div class="engine-service-fallback" aria-hidden="true">
      {(['web', 'automation', 'data', 'ai'] as const).map((kind) => (
        <div data-fallback-mode={kind}>
          <ServiceVisual kind={kind} />
        </div>
      ))}
    </div>
  </div>
  <div class="engine-controls" role="group" aria-label="Choisir une transformation du Morph Engine">
    {engineModes.map((mode) => (
      <button type="button" data-engine-mode={mode.key} aria-pressed={mode.key === 'brand'}>
        <span>{mode.number}</span>
        {mode.label}
      </button>
    ))}
  </div>
  <p class="engine-caption" aria-live="polite" data-engine-caption>
    {engineModes[0].caption}
  </p>
  <span class="sr-only" data-engine-number>
    00
  </span>
</div>
<style>
  .morph-engine {
    width: 100%;
    position: relative;
    isolation: isolate;
  }
  .engine-meta {
    display: flex;
    justify-content: space-between;
    font-size: 8px;
    letter-spacing: 0.16em;
    color: var(--muted);
    padding: 0 16px;
    gap: 20px;
  }
  .engine-meta > span:first-child {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .engine-meta i {
    width: 4px;
    height: 4px;
    display: inline-block;
    background: var(--accent);
    border-radius: 50%;
  }
  .engine-stage {
    position: relative;
    margin: 12px 0 4px;
  }
  .engine-service-fallback {
    position: absolute;
    inset: 6% 10% 24%;
    pointer-events: none;
  }
  [data-fallback-mode] {
    display: none;
    width: 100%;
    height: 100%;
  }
  .engine-service-fallback :global(.service-visual) {
    width: 100%;
    height: 100%;
    color: var(--accent);
  }
  .morph-engine[data-state='web'] [data-fallback-mode='web'],
  .morph-engine[data-state='automation'] [data-fallback-mode='automation'],
  .morph-engine[data-state='data'] [data-fallback-mode='data'],
  .morph-engine[data-state='ai'] [data-fallback-mode='ai'] {
    display: block;
  }
  .morph-engine[data-ready='true'] .engine-service-fallback {
    visibility: hidden;
  }
  .morph-engine:not([data-state='brand']) :global(.brand-playback) {
    visibility: hidden;
  }
  .engine-controls {
    display: grid;
    grid-template-columns: 0.9fr 0.75fr 1.55fr 0.7fr 0.65fr;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .engine-controls button {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font: inherit;
    font-size: 10px;
    color: var(--muted);
    background: none;
    border: 0;
    padding: 19px 4px;
    cursor: pointer;
    min-height: 48px;
  }
  .engine-controls button span {
    font-size: 7px;
    opacity: 0.75;
  }
  .engine-controls button:after {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s;
  }
  .engine-controls button[aria-pressed='true'] {
    color: var(--ink);
  }
  .engine-controls button[aria-pressed='true']:after {
    transform: scaleX(1);
  }
  .engine-controls button:hover {
    background: var(--surface-hover);
  }
  .engine-caption {
    font-size: 10px;
    line-height: 1.7;
    color: var(--muted);
    margin: 15px 15px 0;
    min-height: 34px;
  }
  @media (max-width: 760px) {
    .engine-stage {
      margin-top: 22px;
    }
    .engine-meta {
      font-size: 7px;
    }
    .engine-controls button {
      font-size: 9px;
      gap: 5px;
    }
    .engine-controls button span {
      display: none;
    }
    .engine-caption {
      font-size: 11px;
      margin-top: 15px;
    }
  }
</style>
