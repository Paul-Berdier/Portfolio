---
import type { Project } from '../content/projects';
import {
  sampleDocuments,
  sampleRoutedDocuments,
  sampleSummary,
  sampleData,
  formatAmount,
} from '../content/lab';
interface Props {
  project: Project;
  variant?: string;
}
const { project, variant = '' } = Astro.props;
---

<div
  class:list={['project-preview', project.preview, variant]}
  aria-label={`Aperçu du démonstrateur ${project.title}`}
>
  <div class="preview-top">
    <span class="preview-dot"></span>
    <span>{project.preview === 'workflow' ? 'DOCUMENT FLOW' : 'DATA WORKSPACE'}</span>
    <span class="preview-local">LOCAL / DÉMO</span>
  </div>
  {project.preview === 'workflow' ? (
    <div class="workflow-preview">
      <div class="document-stack">
        <span class="tiny-label">ENTRÉE · {sampleDocuments.length} DOCUMENTS</span>
        {sampleDocuments.map((doc, i) => (
          <div class="document-line" style={`--doc-index:${i}`}>
            <svg viewBox="0 0 18 22" width="16" height="19" aria-hidden="true">
              <path
                d="M1 1h10l6 6v14H1zM11 1v6h6M4 12h10M4 16h7"
                fill="none"
                stroke="currentColor"
              />
            </svg>
            <span>{doc.name}</span>
            <span class="document-id">0{i + 1}</span>
          </div>
        ))}
      </div>
      <div class="flow-connector" aria-hidden="true">
        <span></span>
        <div>↗</div>
        <span></span>
      </div>
      <div class="flow-results">
        <span class="tiny-label">RÈGLES APPLIQUÉES</span>
        <div class="flow-result ready">
          <span class="result-icon">✓</span>
          <span>
            Prêts à exporter<small>Référence vérifiée</small>
          </span>
          <strong>
            {sampleRoutedDocuments.filter((doc) => doc.destination === 'Prêt à exporter').length}
          </strong>
        </div>
        <div class="flow-result review">
          <span class="result-icon">!</span>
          <span>
            À vérifier<small>Validation humaine</small>
          </span>
          <strong>
            {sampleRoutedDocuments.filter((doc) => doc.destination === 'À vérifier').length}
          </strong>
        </div>
      </div>
    </div>
  ) : (
    <div class="data-preview">
      <div class="data-title">
        <div>
          <span class="tiny-label">MONTANTS PAR CATÉGORIE</span>
          <p>Une vue d’ensemble.</p>
        </div>
        <span class="quality-label">{sampleData.rows.length} lignes valides</span>
      </div>
      <div
        class="preview-chart"
        role="img"
        aria-label={`Données synthétiques : ${sampleSummary.map((item) => `${item.category}, ${formatAmount(item.amount)} euros`).join(' ; ')}`}
      >
        <div class="chart-rule"></div>
        <div class="chart-rule"></div>
        <div class="chart-rule"></div>
        {sampleSummary.map((item) => (
          <div class="chart-column">
            <span>{formatAmount(item.amount)} €</span>
            <div class="chart-bar" style={`--bar-height:${(item.amount / 2100) * 100}%`}></div>
            <small>{item.category}</small>
          </div>
        ))}
      </div>
      <div class="data-footer">
        <span>CSV → normalisation → agrégation</span>
        <span>Données synthétiques</span>
      </div>
    </div>
  )}
</div>
<style>
  .project-preview {
    padding: 28px;
    min-height: 310px;
    border: 1px solid #a7b89524;
    background: #20261e;
    color: #e4eadb;
    position: relative;
    overflow: hidden;
  }
  .project-preview.workflow {
    background: #1d251e;
  }
  .project-preview.data {
    background: #252923;
  }
  .preview-top {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 9px;
    letter-spacing: 0.12em;
    font-family: monospace;
    color: #b8c5ae;
    padding-bottom: 25px;
    border-bottom: 1px solid #a7b89524;
  }
  .preview-dot {
    width: 6px;
    height: 6px;
    background: #bdc9a4;
    border-radius: 50%;
  }
  .preview-local {
    margin-left: auto;
    color: #c2c9b7;
    font-size: 8px;
  }
  .workflow-preview {
    display: grid;
    grid-template-columns: 1fr 65px 1fr;
    align-items: center;
    min-height: 245px;
  }
  .tiny-label {
    font-size: 8px;
    font-family: monospace;
    letter-spacing: 0.1em;
    color: #c2cab7;
    display: block;
    margin-bottom: 14px;
  }
  .document-line {
    display: flex;
    align-items: center;
    gap: 9px;
    background: #2c352b;
    border: 1px solid #abbda233;
    margin: 8px 0;
    padding: 12px 10px;
    font: 10px monospace;
    transform: rotate(calc((var(--doc-index) - 1) * -2deg));
  }
  .document-line svg {
    flex: 0 0 auto;
    color: #b5cfa1;
  }
  .document-id {
    color: #a6b19c;
    font-size: 8px;
    margin-left: auto;
  }
  .flow-connector {
    display: flex;
    align-items: center;
    margin-top: 22px;
  }
  .flow-connector span {
    flex: 1;
    height: 1px;
    background: #b7c2a74d;
  }
  .flow-connector div {
    width: 33px;
    height: 33px;
    display: grid;
    place-items: center;
    background: #bacd9d;
    color: #222a1d;
    font-size: 20px;
  }
  .flow-result {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 14px 11px;
    border: 1px solid #adc7994d;
    font-size: 10px;
    margin: 9px 0;
    background: #2a3528;
  }
  .flow-result small {
    display: block;
    color: #b2bea9;
    font-size: 8px;
    margin-top: 5px;
  }
  .flow-result strong {
    margin-left: auto;
    font-weight: 400;
    font-size: 23px;
    color: #d7e8c9;
  }
  .result-icon {
    border: 1px solid #afc69a;
    border-radius: 50%;
    width: 17px;
    height: 17px;
    display: grid;
    place-items: center;
    font-size: 10px;
    flex: 0 0 auto;
  }
  .review {
    border-color: #b69d6944;
    background: #302e23;
  }
  .review .result-icon {
    color: #e0c8a0;
    border-color: #bca678;
  }
  .data-title {
    display: flex;
    justify-content: space-between;
    align-items: start;
    margin-top: 22px;
    gap: 15px;
  }
  .data-title p {
    font-size: 20px;
    margin: 0;
    letter-spacing: -0.04em;
  }
  .data-title .tiny-label {
    margin-bottom: 6px;
  }
  .quality-label {
    font-size: 8px;
    padding: 5px 7px;
    color: #d5e7bf;
    border: 1px solid #a0b58555;
    white-space: nowrap;
  }
  .preview-chart {
    height: 160px;
    display: flex;
    align-items: end;
    gap: 20px;
    position: relative;
    padding: 25px 15px 25px;
    margin-top: 15px;
  }
  .chart-rule {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: #b5c2a722;
    bottom: 25px;
  }
  .chart-rule:nth-child(2) {
    bottom: 70px;
  }
  .chart-rule:nth-child(3) {
    bottom: 115px;
  }
  .chart-column {
    position: relative;
    flex: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
  }
  .chart-bar {
    height: var(--bar-height);
    min-height: 1px;
    max-width: 76px;
    width: 80%;
    background: #a7bc86;
    flex-shrink: 1;
  }
  .chart-column:nth-last-child(2) .chart-bar {
    background: #e89b66;
  }
  .chart-column:last-child .chart-bar {
    background: #718665;
  }
  .chart-column span {
    font: 9px monospace;
    white-space: nowrap;
    margin-bottom: 7px;
  }
  .chart-column small {
    font-size: 8px;
    position: absolute;
    bottom: -18px;
    white-space: nowrap;
  }
  .data-footer {
    display: flex;
    gap: 16px;
    justify-content: space-between;
    border-top: 1px solid #a7b89524;
    padding-top: 14px;
    margin-top: 10px;
    color: #b4bea9;
    font: 8px monospace;
  }
  @media (max-width: 600px) {
    .project-preview {
      padding: 18px;
      min-height: 290px;
    }
    .workflow-preview {
      grid-template-columns: 1fr 30px 1fr;
    }
    .document-line {
      font-size: 8px;
      padding: 10px 6px;
      gap: 6px;
    }
    .document-id {
      display: none;
    }
    .flow-result {
      padding: 11px 6px;
      gap: 6px;
      font-size: 8px;
    }
    .flow-result small {
      font-size: 7px;
    }
    .result-icon {
      width: 14px;
      height: 14px;
    }
    .flow-result strong {
      font-size: 18px;
    }
    .tiny-label {
      font-size: 7px;
    }
    .data-title p {
      font-size: 18px;
    }
    .quality-label {
      font-size: 7px;
    }
    .data-footer {
      font-size: 7px;
      gap: 7px;
    }
    .chart-column small {
      font-size: 7px;
    }
  }
</style>
