---
import type { Project } from '../content/projects';
import { localeFromPath, translate } from '../i18n';
import { getLabMessages, labCategoryLabel } from '../i18n/lab';
import {
  sampleDocuments,
  sampleRoutedDocuments,
  sampleSummary,
  sampleData,
  formatAmount,
} from '../content/lab';
interface Props {
  project: Project;
  variant?: string;
}
const { project, variant = '' } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const t = (fr: string, en: string, es: string) => translate(locale, fr, en, es);
const messages = getLabMessages(locale);
---

<div
  class:list={['project-preview', project.preview, variant]}
  aria-label={
    t('Aperçu du démonstrateur ', 'Demo preview: ', 'Vista previa de la demostración: ') +
    project.title
  }
>
  <div class="preview-top">
    <span class="preview-dot"></span>
    <span>
      {project.preview === 'workflow'
        ? t('DOCUMENT FLOW', 'DOCUMENT FLOW', 'FLUJO DOCUMENTAL')
        : t('DATA WORKSPACE', 'DATA WORKSPACE', 'TALLER DE DATOS')}
    </span>
    <span class="preview-local">{t('LOCAL / DÉMO', 'LOCAL / DEMO', 'LOCAL / DEMO')}</span>
  </div>
  {project.preview === 'workflow' ? (
    <div class="workflow-preview">
      <div class="document-stack">
        <span class="tiny-label">
          {t('ENTRÉE', 'INPUT', 'ENTRADA')} · {sampleDocuments.length}{' '}
          {t('DOCUMENTS', 'DOCUMENTS', 'DOCUMENTOS')}
        </span>
        {sampleDocuments.map((doc, i) => (
          <div class="document-line" style={`--doc-index:${i}`}>
            <svg viewBox="0 0 18 22" width="16" height="19" aria-hidden="true">
              <path
                d="M1 1h10l6 6v14H1zM11 1v6h6M4 12h10M4 16h7"
                fill="none"
                stroke="currentColor"
              />
            </svg>
            <span>{doc.name}</span>
            <span class="document-id">0{i + 1}</span>
          </div>
        ))}
      </div>
      <div class="flow-connector" aria-hidden="true">
        <svg viewBox="0 0 70 65" fill="none">
          <path d="M0 45C29 63 33 9 70 22L70 34C40 20 35 75 0 57Z" fill="var(--accent-solid)" />
          <path d="M0 45C29 63 33 9 70 22" stroke="var(--accent-hover)" stroke-width="1.5" />
        </svg>
      </div>
      <div class="flow-results">
        <span class="tiny-label">
          {t('RÈGLES APPLIQUÉES', 'RULES APPLIED', 'REGLAS APLICADAS')}
        </span>
        <div class="flow-result ready">
          <span class="result-icon">✓</span>
          <span>
            {t('Prêts à exporter', 'Ready to export', 'Listos para exportar')}
            <small>{t('Référence vérifiée', 'Reference checked', 'Referencia verificada')}</small>
          </span>
          <strong>
            {sampleRoutedDocuments.filter((doc) => doc.destination === 'Prêt à exporter').length}
          </strong>
        </div>
        <div class="flow-result review">
          <span class="result-icon">!</span>
          <span>
            {messages.review}
            <small>{t('Validation humaine', 'Human review', 'Revisión humana')}</small>
          </span>
          <strong>
            {sampleRoutedDocuments.filter((doc) => doc.destination === 'À vérifier').length}
          </strong>
        </div>
      </div>
    </div>
  ) : (
    <div class="data-preview">
      <div class="data-title">
        <div>
          <span class="tiny-label">
            {t('MONTANTS PAR CATÉGORIE', 'AMOUNTS BY CATEGORY', 'IMPORTES POR CATEGORÍA')}
          </span>
          <p>{t('Une vue d’ensemble.', 'The full picture.', 'Una visión de conjunto.')}</p>
        </div>
        <span class="quality-label">
          {sampleData.rows.length} {t('lignes valides', 'valid rows', 'filas válidas')}
        </span>
      </div>
      <div
        class="preview-chart"
        role="img"
        aria-label={
          t('Données synthétiques : ', 'Synthetic data: ', 'Datos sintéticos: ') +
          sampleSummary
            .map(
              (item) =>
                `${labCategoryLabel(item.category, locale)}, ${formatAmount(item.amount, locale)} euros`,
            )
            .join(' ; ')
        }
      >
        <div class="chart-rule"></div>
        <div class="chart-rule"></div>
        <div class="chart-rule"></div>
        {sampleSummary.map((item) => (
          <div class="chart-column">
            <span>{formatAmount(item.amount, locale)} €</span>
            <div class="chart-bar" style={`--bar-height:${(item.amount / 2100) * 100}%`}></div>
            <small>{labCategoryLabel(item.category, locale)}</small>
          </div>
        ))}
      </div>
      <div class="data-footer">
        <span>
          {t(
            'CSV → normalisation → agrégation',
            'CSV → normalisation → aggregation',
            'CSV → normalización → agregación',
          )}
        </span>
        <span>{t('Données synthétiques', 'Synthetic data', 'Datos sintéticos')}</span>
      </div>
    </div>
  )}
</div>
<style>
  .project-preview {
    padding: 28px;
    min-height: 310px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    position: relative;
    overflow: hidden;
    border-radius: 12px;
  }
  .project-preview.workflow {
    background: var(--surface);
  }
  .project-preview.data {
    background: var(--surface-raised);
  }
  .preview-top {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 9px;
    letter-spacing: 0.12em;
    font-family: monospace;
    color: var(--muted);
    padding-bottom: 25px;
    border-bottom: 1px solid var(--line);
  }
  .preview-dot {
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 50%;
  }
  .preview-local {
    margin-left: auto;
    color: var(--muted);
    font-size: 8px;
  }
  .workflow-preview {
    display: grid;
    grid-template-columns: 1fr 65px 1fr;
    align-items: center;
    min-height: 245px;
  }
  .tiny-label {
    font-size: 8px;
    font-family: monospace;
    letter-spacing: 0.1em;
    color: var(--muted);
    display: block;
    margin-bottom: 14px;
  }
  .document-line {
    display: flex;
    align-items: center;
    gap: 9px;
    background: var(--surface-raised);
    border: 1px solid var(--line);
    margin: 8px 0;
    padding: 12px 10px;
    font: 10px monospace;
    transform: rotate(calc((var(--doc-index) - 1) * -2deg));
    border-radius: 7px;
  }
  .document-line svg {
    flex: 0 0 auto;
    color: var(--accent);
  }
  .document-id {
    color: var(--muted);
    font-size: 8px;
    margin-left: auto;
  }
  .flow-connector {
    display: flex;
    align-items: center;
    margin-top: 22px;
  }
  .flow-connector svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .flow-result {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 14px 11px;
    border: 1px solid var(--success-line);
    font-size: 10px;
    margin: 9px 0;
    background: var(--success-soft);
    border-radius: 8px;
  }
  .flow-result small {
    display: block;
    color: var(--muted);
    font-size: 8px;
    margin-top: 5px;
  }
  .flow-result strong {
    margin-left: auto;
    font-weight: 400;
    font-size: 23px;
    color: var(--success);
  }
  .result-icon {
    border: 1px solid var(--success);
    border-radius: 50%;
    width: 17px;
    height: 17px;
    display: grid;
    place-items: center;
    font-size: 10px;
    flex: 0 0 auto;
  }
  .review {
    border-color: var(--warning-line);
    background: var(--warning-soft);
  }
  .review strong {
    color: var(--warning);
  }
  .review .result-icon {
    color: var(--warning);
    border-color: var(--warning);
  }
  .data-title {
    display: flex;
    justify-content: space-between;
    align-items: start;
    margin-top: 22px;
    gap: 15px;
  }
  .data-title p {
    font-size: 20px;
    margin: 0;
    letter-spacing: -0.04em;
  }
  .data-title .tiny-label {
    margin-bottom: 6px;
  }
  .quality-label {
    font-size: 8px;
    padding: 5px 7px;
    color: var(--success);
    border: 1px solid var(--success-line);
    white-space: nowrap;
  }
  .preview-chart {
    height: 160px;
    display: flex;
    align-items: end;
    gap: 20px;
    position: relative;
    padding: 25px 15px 25px;
    margin-top: 15px;
  }
  .chart-rule {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--line);
    bottom: 25px;
  }
  .chart-rule:nth-child(2) {
    bottom: 70px;
  }
  .chart-rule:nth-child(3) {
    bottom: 115px;
  }
  .chart-column {
    position: relative;
    flex: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
  }
  .chart-bar {
    height: var(--bar-height);
    min-height: 1px;
    max-width: 76px;
    width: 80%;
    background: var(--chart-web);
    flex-shrink: 1;
    border-radius: 5px 5px 0 0;
  }
  .chart-column:nth-last-child(2) .chart-bar {
    background: var(--chart-data);
  }
  .chart-column:last-child .chart-bar {
    background: var(--chart-automation);
  }
  .chart-column span {
    font: 9px monospace;
    white-space: nowrap;
    margin-bottom: 7px;
  }
  .chart-column small {
    font-size: 8px;
    position: absolute;
    bottom: -18px;
    white-space: nowrap;
  }
  .data-footer {
    display: flex;
    gap: 16px;
    justify-content: space-between;
    border-top: 1px solid var(--line);
    padding-top: 14px;
    margin-top: 10px;
    color: var(--muted);
    font: 8px monospace;
  }
  @media (max-width: 600px) {
    .project-preview {
      padding: 18px;
      min-height: 290px;
    }
    .workflow-preview {
      grid-template-columns: 1fr 30px 1fr;
    }
    .document-line {
      font-size: 8px;
      padding: 10px 6px;
      gap: 6px;
    }
    .document-id {
      display: none;
    }
    .flow-result {
      padding: 11px 6px;
      gap: 6px;
      font-size: 8px;
    }
    .flow-result small {
      font-size: 7px;
    }
    .result-icon {
      width: 14px;
      height: 14px;
    }
    .flow-result strong {
      font-size: 18px;
    }
    .tiny-label {
      font-size: 7px;
    }
    .data-title p {
      font-size: 18px;
    }
    .quality-label {
      font-size: 7px;
    }
    .data-footer {
      font-size: 7px;
      gap: 7px;
    }
    .chart-column small {
      font-size: 7px;
    }
  }
</style>
