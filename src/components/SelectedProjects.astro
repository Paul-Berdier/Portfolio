---
import { getSelectedProjects } from '../content/selected-projects';
import { localeFromPath, localizePath, translate } from '../i18n';
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const projects = getSelectedProjects(locale);
const t = (fr: string, en: string, es: string) => translate(locale, fr, en, es);
---
<section class:list={['selected-projects', { compact }]} id="selected-projects" aria-labelledby="selected-projects-title">
  <div class="selected-heading">
    <div><p class="eyebrow">{t('Projets & contributions', 'Projects & contributions', 'Proyectos y contribuciones')}</p><h2 id="selected-projects-title" data-reveal>{t('Au-delà de la démo.', 'Beyond the demo.', 'Más allá de la demostración.')}</h2></div>
    <p>{t('Des projets personnels et collectifs, avec du code consultable et un rôle expliqué.', 'Personal and team projects, with source code you can explore and a clear account of my role.', 'Proyectos personales y en equipo, con código consultable y una contribución explicada.')}</p>
  </div>
  <div class="selected-grid">
    {projects.map((project, index) => (
      <article class="selected-card" id={project.id} data-selected-project>
        <div class="selected-top"><span class="selected-number" aria-hidden="true">0{index + 1}</span><p class="selected-kind">{project.kind}</p></div>
        <h3>{project.name}</h3><p class="selected-summary">{project.summary}</p>
        <p class="selected-status">{project.status}</p>
        <ul class="selected-stack" aria-label={t('Technologies', 'Technologies', 'Tecnologías')}>{project.stack.map((item) => <li>{item}</li>)}</ul>
        {compact ? (
          <a class="text-link" href={localizePath('/realisations', locale) + '#' + project.id}>{t('Voir le projet', 'Explore the project', 'Ver el proyecto')}<span aria-hidden="true">↗</span></a>
        ) : (
          <>
            <details class="selected-details">
              <summary>{t('Mon rôle, le périmètre et les limites', 'My role, scope and limitations', 'Mi contribución, el alcance y los límites')}</summary>
              <dl><div><dt>{t('Mon rôle', 'My role', 'Mi contribución')}</dt><dd>{project.role}</dd></div><div><dt>{t('Ce qui est présenté', 'What is presented', 'Qué se presenta')}</dt><dd>{project.scope}</dd></div><div><dt>{t('État et limites', 'Status and limitations', 'Estado y límites')}</dt><dd>{project.limits}</dd></div></dl>
              <ol class="selected-flow" aria-label={t('Organisation du projet', 'Project structure', 'Estructura del proyecto')}>{project.flow.map((step) => <li>{step}</li>)}</ol>
            </details>
            <div class="selected-links"><a class="text-link" href={project.repository}>{t('Code sur GitHub', 'Code on GitHub', 'Código en GitHub')}<span aria-hidden="true">↗</span></a><a class="source-link" href={project.source}>{t('Documentation', 'Documentation', 'Documentación')}</a></div>
          </>
        )}
      </article>
    ))}
  </div>
</section>
<style>
  .selected-projects { padding-block: 72px; border-top: 1px solid var(--line); }
  .selected-heading { display: grid; grid-template-columns: 1.3fr 1fr; gap: 32px; align-items: end; margin-bottom: 36px; }
  h2 { margin-top: 20px; }
  .selected-heading > p { color: var(--muted); font-size: 16px; line-height: 1.8; max-width: 48ch; }
  .selected-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; align-items: start; }
  .selected-card { min-width: 0; padding: 26px; border: 1px solid var(--line); background: var(--surface-deep); border-radius: 12px; scroll-margin-top: 32px; }
  .selected-card:hover, .selected-card:focus-within { border-color: var(--accent-line); }
  .selected-top { display: flex; gap: 14px; align-items: baseline; margin-bottom: 28px; }
  .selected-number { font-family: var(--display); font-size: 24px; color: var(--accent); }
  .selected-kind { font-size: 12px; color: var(--muted); line-height: 1.6; }
  h3 { font-size: clamp(26px, 2.2vw, 34px); line-height: 1.2; letter-spacing: -.035em; }
  .selected-summary { margin-top: 18px; font-size: 16px; line-height: 1.8; color: var(--muted); }
  .selected-status { margin-top: 18px; font-size: 13px; line-height: 1.6; color: var(--accent-hover); }
  .selected-stack { display: flex; flex-wrap: wrap; list-style: none; padding: 0; gap: 8px; margin: 20px 0; }
  .selected-stack li { padding: 4px 8px; border: 1px solid var(--line); border-radius: 4px; font-size: 12px; line-height: 1.5; }
  .selected-details { border-top: 1px solid var(--line); margin-top: 24px; }
  summary { cursor: pointer; padding-block: 18px; line-height: 1.65; font-size: 14px; color: var(--accent); }
  dl { margin: 0; }
  dl > div { margin: 8px 0 20px; }
  dt { color: var(--ink); font-size: 14px; font-weight: 650; }
  dd { margin: 6px 0 0; font-size: 15px; line-height: 1.85; color: var(--muted); }
  .selected-flow { list-style: decimal-leading-zero; padding-left: 28px; color: var(--accent); }
  .selected-flow li { padding: 8px 0 8px 6px; font-size: 14px; line-height: 1.6; }
  .selected-links { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 20px; }
  .source-link { color: var(--muted); font-size: 13px; text-decoration: underline; text-underline-offset: 4px; padding-block: 12px; }
  @media (max-width: 1050px) { .selected-grid { grid-template-columns: 1fr; } .selected-card { padding: 28px; } .selected-summary { max-width: 68ch; } .selected-top { margin-bottom: 16px; } }
  @media (max-width: 760px) { .selected-projects { padding-block: 40px; } .selected-heading { grid-template-columns: 1fr; gap: 22px; } .selected-card { padding: 22px; } }
</style>
