---
import type { ServiceSlug } from '../content/services';
interface Props {
  type?: ServiceSlug;
  slug?: ServiceSlug;
  kind?: 'web' | 'automation' | 'data' | 'ai';
  compact?: boolean;
}
const { type, slug, kind, compact = false } = Astro.props;
const kindMap: Record<string, ServiceSlug> = {
  web: 'developpement-web',
  automation: 'automatisation',
  data: 'data',
  ai: 'intelligence-artificielle',
};
const service = type ?? slug ?? (kind ? kindMap[kind] : 'developpement-web')!;
const gradientId = 'service-flow-' + crypto.randomUUID();
const labels = {
  'developpement-web': 'Une matière souple devient une interface web structurée.',
  automatisation: 'Un flux courbe relie les documents, leur contrôle et deux destinations.',
  data: 'Des lignes de données convergent et alimentent trois colonnes lisibles.',
  'intelligence-artificielle':
    'Un extrait de document rejoint une réponse et sa référence vérifiable.',
};
---

<div class:list={['service-visual', { compact }]} data-service-scene={service}>
  <svg viewBox="0 0 400 220" role="img" aria-label={labels[service]}>
    <defs>
      <linearGradient id={gradientId} x1="0" y1="1" x2="1" y2="0">
        <stop offset="0" stop-color="var(--brand-periwinkle)" />
        <stop offset=".48" stop-color="var(--brand-violet)" />
        <stop offset="1" stop-color="var(--brand-lavender)" />
      </linearGradient>
    </defs>
    <path d="M12 184C102 217 199 165 388 193" fill="none" stroke="var(--line)" />
    {service === 'developpement-web' && (
      <>
        <g class="scene-part">
          <path
            d="M18 165C58 182 24 90 72 67L94 85C60 97 92 201 18 184Z"
            fill={'url(#' + gradientId + ')'}
          />
          <path
            d="M19 168C62 184 30 87 79 74"
            fill="none"
            stroke="var(--brand-lavender)"
            stroke-opacity=".6"
          />
        </g>
        <g class="scene-part">
          <rect
            x="100"
            y="32"
            width="252"
            height="151"
            rx="12"
            fill="var(--surface-deep)"
            stroke="var(--border-control)"
          />
          <path d="M100 61h252" stroke="var(--line)" />
          <circle cx="115" cy="46" r="2" fill="var(--accent)" />
          <circle cx="124" cy="46" r="2" fill="var(--muted)" />
          <circle cx="133" cy="46" r="2" fill="var(--muted)" />
        </g>
        <g class="scene-part">
          <path
            d="M124 85h85M124 96h66"
            stroke="var(--ink)"
            stroke-width="5"
            stroke-linecap="round"
          />
          <path
            d="M124 115h84M124 125h70"
            stroke="var(--muted)"
            stroke-width="2"
            stroke-linecap="round"
          />
          <rect x="121" y="144" width="62" height="17" rx="8" fill="var(--accent-solid)" />
        </g>
        <g class="scene-part">
          <path
            d="M232 143C250 142 246 87 269 86C294 84 280 144 306 146C323 147 332 129 337 120L337 142C323 161 302 166 288 147C275 130 284 99 269 100C257 100 267 159 232 156Z"
            fill={'url(#' + gradientId + ')'}
          />
          <path
            d="M233 144C254 145 245 89 269 89"
            fill="none"
            stroke="var(--brand-lavender)"
            stroke-width="1.5"
          />
        </g>
      </>
    )}
    {service === 'automatisation' && (
      <>
        <g class="scene-part">
          <path
            d="M88 108C119 74 137 74 169 103L172 120C142 91 121 91 90 126Z"
            fill={'url(#' + gradientId + ')'}
          />
          <path
            d="M201 109C241 115 240 50 295 57L295 69C250 62 257 125 201 121Z"
            fill={'url(#' + gradientId + ')'}
          />
          <path
            d="M205 116C247 115 248 169 296 160"
            fill="none"
            stroke="var(--warning)"
            stroke-width="2"
            stroke-dasharray="3 5"
          />
        </g>
        <g class="scene-part">
          <path
            d="M38 75Q38 69 44 69H83L99 85V142Q99 148 93 148H44Q38 148 38 142Z"
            fill="var(--surface-raised)"
            stroke="var(--border-control)"
          />
          <path d="M83 70V85H98M51 97H84M51 109H79M51 121H85" stroke="var(--accent)" fill="none" />
        </g>
        <g class="scene-part">
          <rect x="159" y="83" width="56" height="56" rx="17" fill="var(--action)" />
          <path
            d="m174 110 8 8 17-19"
            stroke="var(--ink)"
            stroke-width="2.5"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </g>
        <g class="scene-part">
          <rect
            x="295"
            y="35"
            width="69"
            height="50"
            rx="13"
            fill="var(--success-soft)"
            stroke="var(--success-line)"
          />
          <path
            d="m316 59 8 8 16-18"
            stroke="var(--success)"
            stroke-width="2"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </g>
        <g class="scene-part">
          <rect
            x="295"
            y="140"
            width="69"
            height="47"
            rx="13"
            fill="var(--warning-soft)"
            stroke="var(--warning-line)"
          />
          <path
            d="M330 151v12m0 6v2"
            stroke="var(--warning)"
            stroke-width="2"
            stroke-linecap="round"
          />
        </g>
      </>
    )}
    {service === 'data' && (
      <>
        <g class="scene-part" fill="none" stroke-linecap="round">
          <path d="M24 48C78 31 72 122 145 101" stroke="var(--chart-web)" stroke-width="4" />
          <path d="M25 114C80 151 95 69 146 113" stroke="var(--chart-data)" stroke-width="4" />
          <path
            d="M25 168C86 184 92 111 146 128"
            stroke="var(--chart-automation)"
            stroke-width="4"
          />
        </g>
        <g class="scene-part">
          <path
            d="M139 102C176 91 177 118 212 104L212 119C177 135 171 110 144 123Z"
            fill={'url(#' + gradientId + ')'}
          />
          <circle cx="172" cy="115" r="18" fill="var(--surface-deep)" stroke="var(--accent)" />
          <path
            d="m163 115 6 6 13-14"
            stroke="var(--accent)"
            fill="none"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </g>
        <g stroke="var(--line)">
          <path d="M217 62h157M217 99h157M217 136h157M217 173h157" />
        </g>
        <g class="scene-part">
          <path d="M224 173V108Q224 101 231 101H247Q254 101 254 108V173Z" fill="var(--chart-web)" />
          <path d="M274 173V77Q274 70 281 70H297Q304 70 304 77V173Z" fill="var(--chart-data)" />
        </g>
        <g class="scene-part">
          <path
            d="M324 173V42Q324 35 331 35H347Q354 35 354 42V173Z"
            fill="var(--chart-automation)"
          />
          <path
            d="M327 169V44Q327 39 332 39"
            fill="none"
            stroke="var(--brand-lavender)"
            stroke-opacity=".7"
          />
        </g>
      </>
    )}
    {service === 'intelligence-artificielle' && (
      <>
        <g class="scene-part">
          <path
            d="M36 40Q36 34 42 34H108L127 53V170Q127 177 120 177H42Q36 177 36 170Z"
            fill="var(--surface-raised)"
            stroke="var(--border-control)"
          />
          <path
            d="M108 35V54H126M52 67H110M52 78H101M52 99H110M52 110H103M52 121H110M52 145H91"
            stroke="var(--muted)"
            fill="none"
          />
          <rect
            x="47"
            y="92"
            width="69"
            height="36"
            rx="5"
            fill="var(--accent-soft)"
            stroke="var(--accent)"
          />
        </g>
        <g class="scene-part">
          <path
            d="M127 102C165 104 161 44 214 51L214 67C176 57 178 119 127 116Z"
            fill={'url(#' + gradientId + ')'}
          />
          <path
            d="M128 116C176 109 167 172 227 158"
            fill="none"
            stroke="var(--brand-lavender)"
            stroke-width="2"
            stroke-dasharray="3 5"
          />
        </g>
        <g class="scene-part">
          <rect
            x="213"
            y="33"
            width="147"
            height="61"
            rx="12"
            fill="var(--surface-highlight)"
            stroke="var(--accent-line)"
          />
          <path d="M230 52H341M230 64H316M230 76H330" stroke="var(--ink)" stroke-linecap="round" />
          <circle cx="348" cy="85" r="3" fill="var(--brand-lavender)" />
        </g>
        <g class="scene-part">
          <rect
            x="225"
            y="137"
            width="122"
            height="47"
            rx="11"
            fill="var(--surface-deep)"
            stroke="var(--accent)"
          />
          <text x="242" y="166" font-size="11" fill="var(--accent-hover)" font-family="monospace">
            SOURCE [01]
          </text>
        </g>
      </>
    )}
  </svg>
</div>
<style>
  .service-visual {
    width: 100%;
    color: var(--ink);
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .compact {
    max-width: 400px;
  }
</style>
