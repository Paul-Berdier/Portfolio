---
import { ClientRouter } from 'astro:transitions';
import { brand, navigation } from '../config/brand';
import Logo from '../components/Logo.astro';
import { palette } from '../brand/palette.mjs';
import Arrow from '../components/Arrow.astro';
import '../styles/global.css';
import displayFont from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  noindex?: boolean;
}
const { title, description = brand.description, noindex = false } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const indexable = !noindex && brand.production && brand.legalValidated && !!brand.siteUrl;
const canonical = brand.siteUrl ? new URL(pathname, brand.siteUrl).href : undefined;
---

<!doctype html>
<html lang="fr" data-motion="auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={palette.navy} />
    <style
      is:inline
      set:html={`:root{${Object.entries(palette)
        .map(([key, value]) => `--brand-${key}:${value}`)
        .join(';')}}`}
    />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <title>{title} — {brand.name}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} — ${brand.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="fr_FR" />
    {brand.siteUrl && <meta property="og:image" content={`${brand.siteUrl}/og.png`} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {indexable && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@graph': [
            {
              '@type': 'WebSite',
              '@id': `${brand.siteUrl}/#website`,
              url: brand.siteUrl,
              name: brand.name,
              inLanguage: 'fr-FR',
              publisher: { '@id': `${brand.siteUrl}/#person` },
            },
            {
              '@type': 'Person',
              '@id': `${brand.siteUrl}/#person`,
              name: brand.owner,
              url: brand.siteUrl,
            },
          ],
        }).replace(/</g, '\\u003c')}
      />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <script is:inline>
      (() => {
        let preference = 'auto';
        try {
          preference = localStorage.getItem('motion-preference') || 'auto';
        } catch {}
        if (!['auto', 'reduced', 'off'].includes(preference)) preference = 'auto';
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        document.documentElement.dataset.motion =
          preference === 'auto' && reduced ? 'reduced' : preference;
        document.documentElement.classList.add('js');
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Aller au contenu
    </a>
    <header class="site-header container">
      <a class="brand" href="/" aria-label={`${brand.name} — accueil`}>
        <Logo />
      </a>
      <nav class="desktop-nav" aria-label="Navigation principale">
        {navigation.map(({ href, label }) => (
          <a href={href} aria-current={pathname.startsWith(href) ? 'page' : undefined}>
            {label}
          </a>
        ))}
      </nav>
      <a class="header-contact" href="/contact">
        <span>Parlons de votre projet</span>
        <Arrow />
      </a>
      <button
        class="menu-toggle"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Ouvrir le menu"
      >
        <span></span>
        <span></span>
      </button>
    </header>
    <dialog id="mobile-menu" class="mobile-menu" aria-label="Navigation mobile">
      <div class="menu-top">
        <span class="eyebrow">Explorons ensemble</span>
        <button class="menu-close" aria-label="Fermer le menu">
          Fermer <span aria-hidden="true">×</span>
        </button>
      </div>
      <nav aria-label="Navigation mobile">
        {navigation.map(({ href, label }, i) => (
          <a href={href}>
            <small>0{i + 1}</small>
            {label}
            <Arrow />
          </a>
        ))}
        <a href="/contact">
          <small>05</small>Votre projet
          <Arrow />
        </a>
      </nav>
      <p>
        {brand.owner} · {brand.location}
      </p>
    </dialog>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer container">
      <div class="footer-invitation">
        <div>
          <span class="eyebrow">
            <span class="status-dot"></span>Une idée, un besoin, un point de départ.
          </span>
          <h2 data-reveal>
            Et si on lui
            <br />
            donnait <em>forme ?</em>
          </h2>
        </div>
        <a class="footer-arrow" href="/contact" aria-label="Parler de votre projet">
          <Arrow />
        </a>
      </div>
      <div class="footer-meta">
        <p>
          Un interlocuteur. Du premier échange
          <br />
          au dernier détail. <span>{brand.owner}.</span>
        </p>
        <a class="text-link" href="/contact">
          Parler de votre projet <Arrow />
        </a>
      </div>
      <div class="footer-wordmark" aria-hidden="true">
        <Logo />
      </div>
      <div class="footer-bottom">
        <span>
          © {new Date().getFullYear()} {brand.owner}
        </span>
        <div>
          <a href="/mentions-legales">Mentions légales</a>
          <a href="/confidentialite">Confidentialité</a>
        </div>
        <label class="motion-control">
          Animations{' '}
          <select id="motion-preference" aria-label="Préférence d’animations">
            <option value="auto">Automatiques</option>
            <option value="reduced">Réduites</option>
            <option value="off">Désactivées</option>
          </select>
        </label>
      </div>
      {!indexable && (
        <p class="preview-note">
          Version de préproduction · Nom commercial et informations légales en cours de validation.
        </p>
      )}
    </footer>
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
