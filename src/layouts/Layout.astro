---
import { ClientRouter } from 'astro:transitions';
import {
  getBrand,
  getNavigation,
  localeFromPath,
  localizePath,
  alternatePaths,
  locales,
} from '../i18n';
import { ui } from '../i18n/ui';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import Logo from '../components/Logo.astro';
import { palette } from '../brand/palette.mjs';
import Arrow from '../components/Arrow.astro';
import '../styles/global.css';
import displayFont from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  noindex?: boolean;
}
const locale = localeFromPath(Astro.url.pathname);
const brand = getBrand(locale);
const navigation = getNavigation(locale);
const t = (key: Parameters<typeof ui>[1]) => ui(locale, key);
const href = (path: string) => localizePath(path, locale);
const { title, description = brand.description, noindex = false } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const indexable = !noindex && brand.production && brand.legalValidated && !!brand.siteUrl;
const canonical = brand.siteUrl ? new URL(pathname, brand.siteUrl).href : undefined;
const alternates = alternatePaths(pathname);
const ogLocale = { fr: 'fr_FR', en: 'en_GB', es: 'es_ES' };
---

<!doctype html>
<html lang={locale} data-motion="auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={palette.navy} />
    <style
      is:inline
      set:html={`:root{${Object.entries(palette)
        .map(([key, value]) => `--brand-${key}:${value}`)
        .join(';')}}`}
    />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <title>{title} — {brand.name}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    {brand.siteUrl && alternates && (
      <>
        {locales.map((language) => (
          <link
            rel="alternate"
            hreflang={language}
            href={new URL(alternates[language], brand.siteUrl).href}
          />
        ))}
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(alternates.fr, brand.siteUrl).href}
        />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} — ${brand.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale[locale]} />
    {alternates &&
      locales
        .filter((language) => language !== locale)
        .map((language) => <meta property="og:locale:alternate" content={ogLocale[language]} />)}
    {brand.siteUrl && <meta property="og:image" content={`${brand.siteUrl}/og.png`} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {indexable && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@graph': [
            {
              '@type': 'WebSite',
              '@id': `${brand.siteUrl}/#website`,
              url: brand.siteUrl,
              name: brand.name,
              inLanguage: ['fr-FR', 'en-GB', 'es-ES'],
              publisher: { '@id': `${brand.siteUrl}/#person` },
            },
            {
              '@type': 'Person',
              '@id': `${brand.siteUrl}/#person`,
              name: brand.owner,
              url: brand.siteUrl,
            },
          ],
        }).replace(/</g, '\\u003c')}
      />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <script is:inline>
      (() => {
        let preference = 'auto';
        try {
          preference = localStorage.getItem('motion-preference') || 'auto';
        } catch {}
        if (!['auto', 'reduced', 'off'].includes(preference)) preference = 'auto';
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        document.documentElement.dataset.motion =
          preference === 'auto' && reduced ? 'reduced' : preference;
        document.documentElement.classList.add('js');
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t('skip')}
    </a>
    <header class="site-header container">
      <a class="brand" href={href('/')} aria-label={`${brand.name} — ${t('home')}`}>
        <Logo />
      </a>
      <nav class="desktop-nav" aria-label={t('navigation')}>
        {navigation.map(({ href, label }) => (
          <a href={href} aria-current={pathname.startsWith(href) ? 'page' : undefined}>
            {label}
          </a>
        ))}
      </nav>
      <LanguageSwitcher />
      <a class="header-contact" href={href('/contact')} aria-label={t('project')}>
        <span>{t('project')}</span>
        <Arrow />
      </a>
      <button
        class="menu-toggle"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label={t('openMenu')}
      >
        <span></span>
        <span></span>
      </button>
    </header>
    <dialog id="mobile-menu" class="mobile-menu" aria-label={t('mobileNavigation')}>
      <div class="menu-top">
        <span class="eyebrow">{t('explore')}</span>
        <button class="menu-close" aria-label={t('closeMenu')}>
          {t('close')} <span aria-hidden="true">×</span>
        </button>
      </div>
      <nav aria-label={t('mobileNavigation')}>
        {navigation.map(({ href, label }, i) => (
          <a href={href}>
            <small>0{i + 1}</small>
            {label}
            <Arrow />
          </a>
        ))}
        <a href={href('/contact')}>
          <small>05</small>
          {t('yourProject')}
          <Arrow />
        </a>
      </nav>
      <p>
        {brand.owner} · {brand.location}
      </p>
    </dialog>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer container">
      <div class="footer-invitation">
        <div>
          <span class="eyebrow">
            <span class="status-dot"></span>
            {t('idea')}
          </span>
          <h2 data-reveal>
            {t('footerFirst')}
            <br />
            {t('footerSecond')} <em>{t('footerEmphasis')}</em>
          </h2>
        </div>
        <a class="footer-arrow" href={href('/contact')} aria-label={t('contact')}>
          <Arrow />
        </a>
      </div>
      <div class="footer-meta">
        <p>
          {t('singleContact')}
          <br />
          {t('lastDetail')} <span>{brand.owner}.</span>
        </p>
        <a class="text-link" href={href('/contact')}>
          {t('contact')} <Arrow />
        </a>
      </div>
      <div class="footer-wordmark" aria-hidden="true">
        <Logo />
      </div>
      <div class="footer-bottom">
        <span>
          © {new Date().getFullYear()} {brand.owner}
        </span>
        <div>
          <a href={href('/mentions-legales')}>{t('legal')}</a>
          <a href={href('/confidentialite')}>{t('privacy')}</a>
        </div>
        <label class="motion-control">
          {t('animation')}{' '}
          <select id="motion-preference" aria-label={t('motionPreference')}>
            <option value="auto">{t('automatic')}</option>
            <option value="reduced">{t('reduced')}</option>
            <option value="off">{t('off')}</option>
          </select>
        </label>
      </div>
      {!indexable && <p class="preview-note">{t('preview')}</p>}
    </footer>
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
