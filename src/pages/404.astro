---
import Layout from '../layouts/Layout.astro';
import { localeFromPath, localizePath, translate } from '../i18n';
export const prerender = true;
const locale = localeFromPath(Astro.url.pathname);
const t = (fr: string, en: string, es: string) => translate(locale, fr, en, es);
const href = (path: string) => localizePath(path, locale);
---

<Layout
  title={t('Page introuvable', 'Page not found', 'Página no encontrada')}
  description={t(
    'Cette page n’existe pas ou a changé de chemin. Retrouvez les expertises et réalisations de Paul Berdier.',
    'This page does not exist or has moved. Explore Paul Berdier’s services and projects.',
    'Esta página no existe o ha cambiado de dirección. Descubre los servicios y proyectos de Paul Berdier.',
  )}
  noindex
>
  <section class="container page-shell missing-page">
    <div class="missing-code" aria-hidden="true" data-service-scene="404">
      <span class="scene-part">4</span>
      <span class="zero scene-part">↗</span>
      <span class="scene-part">4</span>
    </div>
    <div class="missing-copy">
      <p class="eyebrow">
        {t('Cette piste s’arrête ici', 'This path ends here', 'Este camino termina aquí')}
      </p>
      <h1>
        {t('Retrouvons', 'Let’s find', 'Encontremos')}
        <br />
        <em>{t('le bon chemin.', 'the right path.', 'el camino correcto.')}</em>
      </h1>
      <p>
        {t(
          'La page demandée n’existe pas ou a changé d’adresse. Le reste de l’exploration vous attend.',
          'The page you requested does not exist or has moved. There is more to explore.',
          'La página que buscas no existe o ha cambiado de dirección. Todavía queda mucho por explorar.',
        )}
      </p>
      <div>
        <a href={href('/')} class="button button-primary">
          {t('Retour à l’accueil', 'Back to home', 'Volver al inicio')}{' '}
          <span aria-hidden="true">↗</span>
        </a>
        <a href={href('/realisations')} class="text-link">
          {t('Voir les réalisations', 'Explore my work', 'Ver los proyectos')}{' '}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
<style>
  .missing-page {
    min-height: 75vh;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 7%;
    align-items: center;
  }
  .missing-code {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: clamp(80px, 12vw, 190px);
    line-height: 1;
    letter-spacing: -0.09em;
    color: var(--accent-hover);
    font-weight: 500;
  }
  .missing-code .zero {
    border: 1px solid var(--accent-line);
    border-radius: 50%;
    width: 0.85em;
    height: 0.85em;
    display: grid;
    place-items: center;
    color: var(--accent);
    font-size: 0.8em;
    margin: 0 0.06em;
  }
  .missing-copy h1 {
    font-size: clamp(42px, 5.5vw, 78px);
    line-height: 1.03;
    letter-spacing: -0.06em;
    margin: 25px 0;
  }
  .missing-copy h1 em {
    font-style: normal;
    color: var(--accent);
  }
  .missing-copy p:not(.eyebrow) {
    color: var(--muted);
    font-size: 16px;
    line-height: 1.8;
    max-width: 430px;
  }
  .missing-copy > div {
    display: flex;
    gap: 25px;
    margin-top: 32px;
    align-items: center;
    flex-wrap: wrap;
  }
  .missing-copy .text-link {
    font-size: 13px;
  }
  @media (max-width: 767px) {
    .missing-page {
      grid-template-columns: 1fr;
      gap: 45px;
    }
    .missing-code {
      font-size: 130px;
      justify-content: start;
    }
    .missing-copy h1 {
      font-size: 48px;
    }
  }
</style>
