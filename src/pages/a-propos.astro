---
import Layout from '../layouts/Layout.astro';
import Mark from '../components/Mark.astro';
import { brand } from '../config/brand';
export const prerender = true;
---

<Layout
  title={`À propos — ${brand.owner}`}
  description={`${brand.owner}, à Toulouse et à distance en France. Une approche directe du développement web, de l’automatisation, de la data et de l’IA.`}
>
  <div class="container page-shell">
    <header class="about-hero">
      <div>
        <p class="eyebrow">À propos / Studio solo</p>
        <h1 data-line>
          La technique,
          <br />
          avec quelqu’un
          <br />
          <em>à qui parler.</em>
        </h1>
        <p class="lede">
          Je suis {brand.owner}. Je construis des sites, des applications et des outils pour rendre
          les idées concrètes et le travail plus simple.
        </p>
        <span class="about-location">
          <i></i>
          {brand.location}
        </span>
      </div>
      <div class="about-symbol" aria-hidden="true">
        <svg class="symbol-sweep" viewBox="0 0 400 480" fill="none">
          <path
            d="M-40 365C171 478 132 19 414 151"
            stroke="var(--accent-solid)"
            stroke-width="43"
          />
          <path d="M-40 341C171 454 132 -5 414 127" stroke="var(--accent-hover)" stroke-width="1" />
        </svg>
        <div class="symbol-core">
          <Mark />
        </div>
        <span class="symbol-caption">PENSER. RELIER. CONSTRUIRE.</span>
        <span class="symbol-coordinate">
          43°36′ N — 1°26′ E<br />
          TOULOUSE
        </span>
      </div>
    </header>
    <section class="about-section" data-reveal>
      <p class="eyebrow">Un seul interlocuteur</p>
      <div>
        <h2>
          Du premier échange
          <br />
          <em>au dernier détail.</em>
        </h2>
        <p>
          J’aborde un projet dans son ensemble : ce qu’il doit permettre de faire, les personnes qui
          vont l’utiliser et les contraintes qu’il doit respecter.
        </p>
        <p>
          Le web, l’automatisation, les données et l’IA sont des moyens. Mon point de départ reste
          le même : comprendre ce qui bloque et construire une réponse utile.
        </p>
        <p>
          {brand.name} est le nom de travail de ce portfolio personnel. Derrière ce nom, il y a une
          personne : moi.
        </p>
        {brand.name === 'MorphAI' && (
          <p>
            Le nom évoque Morphée, l’imagination et les idées qui prennent forme. Il exprime aussi
            ma manière de travailler : adapter les technologies, dont l’intelligence artificielle,
            au besoin réel.
          </p>
        )}
      </div>
    </section>
    <section class="about-section" data-reveal>
      <p class="eyebrow">Ce qui guide le travail</p>
      <div class="principles">
        <article>
          <span>01</span>
          <div>
            <h3>Comprendre avant de produire.</h3>
            <p>
              Définir le besoin, les usages et les critères qui permettront de dire que le projet
              est réussi.
            </p>
          </div>
        </article>
        <article>
          <span>02</span>
          <div>
            <h3>Rendre visible, tôt.</h3>
            <p>
              Mettre une première version entre vos mains. Recueillir les retours et ajuster sur
              quelque chose de concret.
            </p>
          </div>
        </article>
        <article>
          <span>03</span>
          <div>
            <h3>Faire des choix explicables.</h3>
            <p>
              Discuter du périmètre, des coûts et des compromis. Choisir une solution proportionnée
              au problème.
            </p>
          </div>
        </article>
        <article>
          <span>04</span>
          <div>
            <h3>Préparer la suite.</h3>
            <p>
              Livrer un outil compréhensible et documenté, avec des limites et des possibilités
              d’évolution claires.
            </p>
          </div>
        </article>
      </div>
    </section>
    <section class="about-section" data-reveal>
      <p class="eyebrow">Les preuves</p>
      <div>
        <h2>
          Commencer par
          <br />
          ce que vous pouvez voir.
        </h2>
        <p>
          Les réalisations actuellement présentées sont des démonstrateurs personnels. Vous pouvez
          manipuler leurs interfaces, comprendre leur fonctionnement et consulter leurs limites.
        </p>
        <a href="/realisations" class="text-link">
          Explorer les réalisations <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
    <div class="about-contact" data-reveal>
      <p class="eyebrow">Un projet en tête ?</p>
      <h2>
        Commençons
        <br />
        <em>par en parler.</em>
      </h2>
      <a href="/contact" class="button button-primary">
        Parler de votre projet <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</Layout>
<style>
  h1 em,
  h2 em {
    color: var(--accent);
    font-style: normal;
  }
  .about-hero {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 7%;
    align-items: center;
    margin-bottom: 120px;
  }
  .about-hero h1 {
    font-size: clamp(43px, 6.8vw, 96px);
    line-height: 1.02;
    letter-spacing: -0.065em;
    margin: 27px 0 35px;
  }
  .about-hero .lede {
    max-width: 570px;
  }
  .about-location {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--muted);
    font-size: 11px;
    margin-top: 30px;
  }
  .about-location i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }
  .about-symbol {
    position: relative;
    aspect-ratio: 1 / 1.2;
    background: var(--surface);
    border: 1px solid var(--line);
    overflow: hidden;
    display: grid;
    place-items: center;
    border-radius: 14px;
  }
  .symbol-core {
    width: 65%;
    position: relative;
    color: var(--accent-hover);
  }
  .symbol-core :global(svg) {
    width: 100%;
    height: auto;
  }
  .symbol-sweep {
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0.3;
  }
  .symbol-caption {
    position: absolute;
    top: 24px;
    left: 24px;
    font: 8px monospace;
    letter-spacing: 0.15em;
    color: var(--muted);
  }
  .symbol-coordinate {
    position: absolute;
    bottom: 24px;
    right: 24px;
    font: 9px/1.7 monospace;
    color: var(--muted);
    text-align: right;
  }
  .about-section {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 6%;
    padding: 65px 0;
    border-top: 1px solid var(--line);
  }
  .about-section h2 {
    font-size: clamp(32px, 4.5vw, 61px);
    line-height: 1.07;
    letter-spacing: -0.05em;
    margin-bottom: 30px;
  }
  .about-section p:not(.eyebrow) {
    color: var(--muted);
    font-size: 17px;
    line-height: 1.85;
    margin: 20px 0;
    max-width: 670px;
  }
  .principles article {
    display: grid;
    grid-template-columns: 35px 1fr;
    gap: 15px;
    padding: 0 0 25px;
  }
  .principles article > span {
    font: 11px monospace;
    color: var(--accent);
    padding-top: 9px;
  }
  .principles h3 {
    font-size: 25px;
    letter-spacing: -0.035em;
  }
  .principles p {
    font-size: 15px !important;
    margin-top: 14px !important;
  }
  .about-contact {
    padding: 65px 0 0;
    margin-left: 35%;
  }
  .about-contact h2 {
    font-size: clamp(45px, 6vw, 82px);
    letter-spacing: -0.065em;
    line-height: 1.02;
    margin: 25px 0 32px;
  }
  @media (max-width: 767px) {
    .about-hero {
      grid-template-columns: 1fr;
      gap: 45px;
      margin-bottom: 65px;
    }
    .about-symbol {
      max-width: 500px;
      aspect-ratio: 1.3;
    }
    .about-section {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 40px 0;
    }
    .about-contact {
      margin-left: 0;
    }
    .about-section p:not(.eyebrow) {
      font-size: 16px;
    }
  }
</style>
