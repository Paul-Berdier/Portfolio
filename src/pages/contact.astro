---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import { brand } from '../config/brand';
import { getContactConfig } from '../server/config';

export const prerender = false;
const config = getContactConfig();
const needFromService = {
  'developpement-web': 'web',
  automatisation: 'automation',
  data: 'data',
  'intelligence-artificielle': 'ai',
} as const;
const requestedNeed = Astro.url.searchParams.get('besoin') || '';
const selectedNeed = Object.hasOwn(needFromService, requestedNeed)
  ? needFromService[requestedNeed as keyof typeof needFromService]
  : undefined;
Astro.response.headers.set('Cache-Control', 'no-store');
if (!config.enabled) Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---

<Layout
  title="Parlons de votre projet"
  description="Un site à créer, un processus à automatiser, des données à exploiter ? Parlez de votre besoin à Paul Berdier, à Toulouse et à distance."
>
  <section class="page-shell contact-page">
    <header class="contact-heading">
      <p class="eyebrow">Contact · Le début de quelque chose</p>
      <h1 class="page-heading">
        Tout commence
        <br />
        par <span>un échange.</span>
      </h1>
      <p class="lede">
        Un besoin précis ou une idée encore floue ?<br />
        Dites-moi ce que vous aimeriez faire avancer.
      </p>
    </header>
    <div class="contact-columns">
      <aside class="contact-aside">
        <div class="contact-mark" aria-hidden="true">
          <svg viewBox="0 0 90 45" fill="none">
            <path
              d="M3 35C26 43 20 3 43 9S61 43 87 8"
              stroke="var(--accent)"
              stroke-width="2"
              stroke-linecap="round"
            />
          </svg>
        </div>
        <h2>
          Votre contexte.
          <br />
          Mon point de départ.
        </h2>
        <p>
          Je prends le temps de comprendre ce qui compte pour vous avant de parler de solution
          technique.
        </p>
        <dl>
          <div>
            <dt>Votre interlocuteur</dt>
            <dd>{brand.owner}</dd>
          </div>
          <div>
            <dt>Où ?</dt>
            <dd>{brand.location}</dd>
          </div>
          <div>
            <dt>Et après ?</dt>
            <dd>Un échange pour préciser le besoin, le périmètre et la suite possible.</dd>
          </div>
        </dl>
        {brand.email && (
          <a class="text-link" href={`mailto:${brand.email}`}>
            {brand.email} <span aria-hidden="true">↗</span>
          </a>
        )}
        {brand.bookingUrl && (
          <a
            class="text-link booking-link"
            href={brand.bookingUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Choisir un créneau <span aria-hidden="true">↗</span>
          </a>
        )}
      </aside>
      <div class="contact-main">
        {!config.enabled && (
          <div class="contact-notice" role="note">
            <span class="notice-dot" aria-hidden="true"></span>
            <div>
              <strong>
                {config.availability === 'preview'
                  ? 'Le formulaire ouvrira bientôt.'
                  : 'Le formulaire est temporairement indisponible.'}
              </strong>
              <p>
                {config.availability === 'preview'
                  ? 'Ce site est en préproduction. La collecte reste fermée jusqu’à la validation des coordonnées et des informations légales. Aucune donnée n’est transmise.'
                  : 'L’enregistrement des demandes n’est pas ouvert pour le moment. Aucune donnée n’est transmise.'}
              </p>
            </div>
          </div>
        )}
        <ContactForm
          enabled={config.enabled}
          retentionMonths={config.retentionMonths}
          selectedNeed={selectedNeed}
        />
      </div>
    </div>
  </section>
</Layout>
<style>
  .contact-page {
    padding-bottom: 7rem;
  }
  .contact-heading {
    padding-bottom: clamp(3rem, 7vw, 7rem);
  }
  .contact-heading h1 {
    max-width: 14ch;
  }
  .contact-heading h1 span {
    color: var(--accent);
  }
  .contact-heading .lede {
    margin-top: 1.8rem;
  }
  .contact-columns {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.4fr);
    gap: clamp(2rem, 7vw, 8rem);
    border-top: 1px solid var(--line);
    padding-top: 3rem;
  }
  .contact-aside h2 {
    font-size: clamp(1.5rem, 2.6vw, 2.6rem);
    letter-spacing: -0.05em;
    line-height: 1.15;
    font-weight: 500;
    margin: 1.75rem 0 1.2rem;
  }
  .contact-aside > p {
    max-width: 31ch;
    color: var(--muted);
    line-height: 1.75;
    font-size: 0.92rem;
  }
  dl {
    display: grid;
    gap: 1.5rem;
    margin: 2.5rem 0;
  }
  dt {
    color: var(--muted);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
  }
  dd {
    margin: 0;
    font-size: 0.87rem;
    line-height: 1.7;
    max-width: 31ch;
  }
  .booking-link {
    display: block;
    margin-top: 1.2rem;
  }
  .contact-mark {
    width: 90px;
    height: 45px;
  }
  .contact-mark svg {
    width: 100%;
    height: 100%;
  }
  .contact-main {
    min-width: 0;
  }
  .contact-notice {
    display: flex;
    gap: 0.9rem;
    padding: 1.2rem;
    background: var(--warning-soft);
    border: 1px solid var(--warning-line);
    border-radius: 5px;
    margin-bottom: 2.5rem;
  }
  .contact-notice strong {
    display: block;
    font-size: 0.86rem;
    font-weight: 500;
    color: var(--warning);
  }
  .contact-notice p {
    margin: 0.45rem 0 0;
    font-size: 0.77rem;
    line-height: 1.7;
    color: var(--muted);
  }
  .notice-dot {
    margin-top: 0.35rem;
    width: 6px;
    height: 6px;
    background: var(--warning);
    border-radius: 50%;
    flex: none;
  }
  @media (max-width: 800px) {
    .contact-columns {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .contact-aside {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem 2rem;
    }
    .contact-mark {
      grid-column: 1 / -1;
    }
    .contact-aside h2 {
      margin: 0;
    }
    .contact-aside > p {
      margin: 0;
    }
    dl {
      grid-column: 1 / -1;
      grid-template-columns: repeat(3, 1fr);
      margin: 1rem 0;
    }
  }
  @media (max-width: 480px) {
    .contact-aside {
      display: block;
    }
    .contact-aside h2 {
      margin: 1.5rem 0 1rem;
    }
    dl {
      grid-template-columns: 1fr;
      margin-top: 2rem;
    }
    .contact-page {
      padding-bottom: 4rem;
    }
  }
</style>
