---
import Layout from '../layouts/Layout.astro';
import MorphEngine from '../components/MorphEngine.astro';
import Arrow from '../components/Arrow.astro';
import ServiceVisual from '../components/ServiceVisual.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import { services } from '../content/services';
import { publishedProjects } from '../content/projects';
import { brand } from '../config/brand';
const steps = [
  ['Échange', 'Comprendre votre quotidien, vos enjeux et ce qui doit changer.'],
  ['Cadrage', 'Définir le bon périmètre, les priorités et les critères de réussite.'],
  ['Conception', 'Rendre la solution tangible avant de construire.'],
  ['Réalisation', 'Développer par étapes, avec des points de suivi concrets.'],
  ['Validation', 'Tester ensemble, transmettre et vous rendre autonome.'],
];
---

<Layout title="Vos idées prennent forme" description={brand.description}>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow">
        <span class="status-dot"></span>Développeur indépendant · Toulouse
      </p>
      <h1 id="hero-title">
        Vos idées.
        <br />
        En{' '}
        <span class="hero-emphasis">
          mouvement
          <svg viewBox="0 0 500 18" fill="none" aria-hidden="true">
            <path d="M2 13C160 1 310 1 498 8" stroke="currentColor" stroke-width="2" />
          </svg>
        </span>
        <span class="accent-period">.</span>
      </h1>
      <p class="hero-description">
        Je transforme vos besoins en outils qui font avancer votre activité.{' '}
        <strong>Web, automatisation, data & IA.</strong>
        <br />
        Du premier échange à la mise en ligne.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="/contact">
          Parler de votre projet
          <Arrow />
        </a>
        <a class="hero-secondary" href="/realisations">
          Explorer les réalisations
          <Arrow diagonal={false} />
        </a>
      </div>
      <div class="hero-signature">
        <span class="signature-line"></span>
        <p>
          {brand.owner}
          <span>La précision du code. La liberté du sur-mesure.</span>
        </p>
      </div>
    </div>
    <div class="hero-art">
      <MorphEngine />
    </div>
    <div class="hero-bottom">
      <a href="#expertises" class="discover-link">
        <span>↓</span> DÉCOUVRIR CE QUE L’ON PEUT CONSTRUIRE
      </a>
      <span>DE L’IDÉE À L’OUTIL. SANS DÉTOUR.</span>
    </div>
  </section>
  <div class="expertise-ribbon" aria-hidden="true">
    <div class="container">
      <span>CONCEVOIR</span>
      <i>↗</i>
      <span>CONNECTER</span>
      <i>↗</i>
      <span>AUTOMATISER</span>
      <i>↗</i>
      <span>TRANSFORMER</span>
      <i>↗</i>
    </div>
  </div>
  <section class="expertise-section container" id="expertises">
    <div class="section-heading">
      <div>
        <p class="section-label">01 / Expertises</p>
        <h2 data-reveal>
          La bonne technologie.
          <br />
          <span class="muted-heading">Pour votre vrai besoin.</span>
        </h2>
      </div>
      <p class="section-intro">
        Un site qui vous ressemble. Des tâches qui s’exécutent seules. Des données qui deviennent
        utiles. On part de votre quotidien.
      </p>
    </div>
    <div class="service-list">
      {services.map((service, i) => (
        <a
          class="service-row"
          href={`/services/${service.slug}`}
          data-service-card
          data-service-index={i}
        >
          <div class="service-number">
            0{i + 1}
            <span>↘</span>
          </div>
          <div class="service-copy">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <div class="service-tags">
              {service.tags.slice(0, 3).map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
          </div>
          <div class="service-visual">
            <ServiceVisual kind={(['web', 'automation', 'data', 'ai'] as const)[i]!} />
          </div>
          <span class="service-link-icon">
            <Arrow />
          </span>
        </a>
      ))}
    </div>
  </section>
  <section class="transformation-section" aria-labelledby="transformation-title">
    <div class="container transformation-grid">
      <div>
        <p class="section-label">L’approche</p>
        <h2 id="transformation-title" data-reveal>
          Moins de friction.
          <br />
          <em>Plus de possibilités.</em>
        </h2>
        <p>
          La technologie a du sens lorsqu’elle simplifie quelque chose. Je relie vos idées, vos
          outils et vos données pour en faire un ensemble qui fonctionne.
        </p>
      </div>
      <div class="system-story" data-story>
        <div class="story-step">
          <span class="story-index">01</span>
          <div>
            <span class="eyebrow">Le point de départ</span>
            <h3>Un besoin</h3>
            <div class="story-fragments" aria-hidden="true">
              <i></i>
              <i></i>
              <i></i>
              <i></i>
              <i></i>
              <i></i>
            </div>
          </div>
        </div>
        <div class="story-step">
          <span class="story-index">02</span>
          <div>
            <span class="eyebrow">Les bonnes connexions</span>
            <h3>Un système</h3>
            <div class="story-system" aria-hidden="true">
              <i></i>
              <span></span>
              <i></i>
              <span></span>
              <i></i>
            </div>
          </div>
        </div>
        <div class="story-step">
          <span class="story-index">03</span>
          <div>
            <span class="eyebrow">Dans votre quotidien</span>
            <h3>Un résultat utilisable</h3>
            <p>Clair. Fiable. À votre mesure.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="projects-section container">
    <div class="section-heading">
      <div>
        <p class="section-label">02 / La preuve par le concret</p>
        <h2 data-reveal>
          Des idées.
          <br />
          <span class="muted-heading">Déjà en action.</span>
        </h2>
      </div>
      <a class="text-link" href="/realisations">
        Toutes les réalisations
        <Arrow />
      </a>
    </div>
    <div class="home-projects">
      {publishedProjects.slice(0, 2).map((project, i) => (
        <a
          class:list={['home-project', `home-project-${i + 1}`]}
          href={`/realisations/${project.slug}`}
        >
          <div class="project-image" data-project-image transition:name={`project-${project.slug}`}>
            <ProjectPreview project={project} />
            <span class="project-open" aria-hidden="true">
              <Arrow />
            </span>
          </div>
          <div class="project-caption">
            <div>
              <span class="eyebrow">Démonstrateur · {project.category}</span>
              <h3>{project.title}</h3>
            </div>
            <span class="project-number">0{i + 1}</span>
          </div>
          <p>{project.summary}</p>
        </a>
      ))}
    </div>
    <p class="project-honesty">
      <span>↳</span> Des démonstrateurs interactifs à explorer, construits avec des données
      fictives. Aucun résultat client revendiqué.
    </p>
  </section>
  <section class="method-section container">
    <div class="section-heading">
      <div>
        <p class="section-label">03 / Du premier échange à la livraison</p>
        <h2 data-reveal>
          Un chemin clair.
          <br />
          <span class="muted-heading">À chaque étape.</span>
        </h2>
      </div>
      <p class="section-intro">
        Vous savez où l’on va, ce qui avance et pourquoi. Je reste votre interlocuteur tout au long
        du projet.
      </p>
    </div>
    <ol class="method-steps">
      {steps.map(([title, description], i) => (
        <li data-method-step>
          <span class="method-number">0{i + 1}</span>
          <div class="method-track">
            <i></i>
          </div>
          <h3>{title}</h3>
          <p>{description}</p>
        </li>
      ))}
    </ol>
  </section>
  <section class="about-section container">
    <div class="about-graphic" aria-hidden="true">
      <span class="about-small">L’INDÉPENDANCE COMME MÉTHODE</span>
      <div class="about-monogram">
        <span>P</span>
        <span>B</span>
        <i>↗</i>
      </div>
      <span class="about-coordinate">43.6047° N / TOULOUSE</span>
    </div>
    <div class="about-copy">
      <p class="section-label">04 / Derrière les outils</p>
      <h2 data-reveal>
        Paul, tout
        <br />
        simplement.
      </h2>
      <p>
        J’aime comprendre comment les choses fonctionnent. Et trouver comment les faire mieux
        fonctionner ensemble.
      </p>
      <p>
        Je conçois des sites, des applications et des systèmes sur mesure. Avec une approche
        directe, de la curiosité et le souci du détail.
      </p>
      <a class="text-link" href="/a-propos">
        Un peu plus sur moi
        <Arrow />
      </a>
    </div>
  </section>
</Layout>
<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 1.06fr 1fr;
    align-items: center;
    padding-top: 72px;
    column-gap: 0;
  }
  .hero-copy {
    position: relative;
    z-index: 3;
    padding-bottom: 22px;
  }
  .hero-eyebrow {
    font-size: 9px;
    letter-spacing: 0.14em;
    margin-bottom: 32px;
  }
  .hero h1 {
    font-size: clamp(61px, 6.9vw, 106px);
    line-height: 1.045;
    letter-spacing: -0.064em;
    white-space: nowrap;
  }
  .hero-emphasis {
    position: relative;
    color: var(--accent);
  }
  .hero-emphasis svg {
    position: absolute;
    left: 0;
    bottom: -12px;
    width: 100%;
    height: 13px;
    overflow: visible;
    opacity: 0.7;
  }
  .accent-period {
    color: var(--accent);
  }
  .hero-description {
    font-size: 13px;
    line-height: 1.9;
    color: var(--muted);
    max-width: 360px;
    margin-top: 36px;
  }
  .hero-description strong {
    font-weight: 500;
    color: var(--ink);
  }
  .hero-actions {
    display: flex;
    gap: 23px;
    align-items: center;
    margin-top: 29px;
  }
  .hero-actions .button {
    gap: 23px;
    font-size: 11px;
    min-height: 51px;
    padding-inline: 20px;
  }
  .hero-secondary {
    display: flex;
    gap: 12px;
    align-items: center;
    min-height: 44px;
    font-size: 10px;
    white-space: nowrap;
  }
  .hero-secondary svg {
    width: 15px;
  }
  .hero-signature {
    display: flex;
    gap: 15px;
    align-items: center;
    margin-top: 44px;
  }
  .signature-line {
    width: 25px;
    height: 1px;
    background: var(--accent);
  }
  .hero-signature p {
    font-size: 10px;
  }
  .hero-signature p span {
    display: block;
    font-size: 9px;
    margin-top: 3px;
    color: #82877b;
  }
  .hero-art {
    min-width: 0;
    margin-left: 5px;
    position: relative;
  }
  .hero-bottom {
    grid-column: 1/-1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 55px;
    padding-bottom: 27px;
    color: #878c80;
    font-size: 7px;
    letter-spacing: 0.13em;
  }
  .discover-link {
    display: flex;
    gap: 12px;
    align-items: center;
    min-height: 30px;
  }
  .discover-link > span {
    font-size: 18px;
    color: var(--ink);
  }
  .expertise-ribbon {
    border-block: 1px solid var(--line);
    background: #151613;
  }
  .expertise-ribbon > .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding-block: 25px;
    font: 400 clamp(15px, 1.65vw, 24px)/1 var(--display);
    letter-spacing: -0.035em;
    color: #b8baae;
  }
  .expertise-ribbon i {
    font-style: normal;
    color: var(--accent);
    font-size: 24px;
  }
  .expertise-section {
    padding-block: 116px 110px;
  }
  .section-label {
    margin-bottom: 26px;
  }
  .muted-heading {
    color: #797e72;
  }
  .section-intro {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.9;
    max-width: 290px;
    padding-bottom: 5px;
  }
  .service-list {
    border-top: 1px solid #ffffff35;
  }
  .service-row {
    display: grid;
    grid-template-columns: 70px 1fr 260px 38px;
    gap: 25px;
    align-items: center;
    border-bottom: 1px solid var(--line);
    padding: 35px 0;
    position: relative;
    min-height: 185px;
    transition: background 0.3s;
  }
  .service-row:before {
    content: '';
    position: absolute;
    inset: 0 -20px;
    background: #ffffff03;
    opacity: 0;
    transition: opacity 0.3s;
    z-index: -1;
  }
  .service-row:hover:before {
    opacity: 1;
  }
  .service-number {
    align-self: start;
    color: var(--muted);
    font-size: 11px;
    padding-top: 9px;
    display: flex;
    flex-direction: column;
    gap: 38px;
  }
  .service-number span {
    color: #666e60;
    font-size: 20px;
  }
  .service-copy h3 {
    font-size: clamp(27px, 2.8vw, 42px);
    margin-bottom: 14px;
    transition: color 0.3s;
  }
  .service-row:hover h3 {
    color: var(--accent);
  }
  .service-copy p {
    max-width: 460px;
    font-size: 11px;
    color: var(--muted);
    line-height: 1.9;
  }
  .service-tags {
    display: flex;
    gap: 15px;
    margin-top: 20px;
    color: #8f9588;
    font-size: 8px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .service-visual {
    height: 115px;
    max-width: 230px;
    opacity: 0.75;
    transition: opacity 0.3s;
  }
  .service-row:hover .service-visual {
    opacity: 1;
  }
  .service-link-icon {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    transition:
      background 0.3s,
      color 0.3s;
  }
  .service-row:hover .service-link-icon {
    background: var(--accent);
    color: var(--bg);
  }
  .transformation-section {
    background: #1b1d18;
    border-block: 1px solid var(--line);
    padding-block: 96px;
  }
  .transformation-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 100px;
    align-items: center;
  }
  .transformation-grid > div > p:last-child {
    font-size: 13px;
    max-width: 390px;
    color: var(--muted);
    line-height: 1.9;
    margin-top: 28px;
  }
  .transformation-grid h2 {
    font-size: clamp(36px, 4.5vw, 60px);
  }
  .system-story {
    padding-left: 30px;
  }
  .story-step {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 15px;
    position: relative;
    padding-bottom: 34px;
  }
  .story-step:before {
    content: '';
    position: absolute;
    left: 16px;
    top: 33px;
    bottom: 0;
    width: 1px;
    background: #f1814b30;
  }
  .story-step:last-child {
    padding-bottom: 0;
  }
  .story-step:last-child:before {
    display: none;
  }
  .story-index {
    font-size: 9px;
    display: grid;
    place-items: center;
    width: 33px;
    height: 33px;
    border: 1px solid #f1814b55;
    border-radius: 50%;
    color: var(--accent);
  }
  .story-step .eyebrow {
    font-size: 7px;
    margin-bottom: 7px;
  }
  .story-step h3 {
    font-size: 27px;
  }
  .story-step p {
    color: var(--muted);
    font-size: 10px;
    margin-top: 10px;
  }
  .story-fragments,
  .story-system {
    height: 36px;
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 12px;
  }
  .story-fragments i {
    width: 22px;
    height: 18px;
    border: 1px solid #f1814b90;
    transform: rotate(-17deg) translateY(5px);
  }
  .story-fragments i:nth-child(2n) {
    transform: rotate(19deg) translateY(-4px);
    background: #f1814b30;
  }
  .story-system i {
    width: 29px;
    height: 24px;
    border: 1px solid var(--accent);
    background: #f1814b20;
  }
  .story-system span {
    width: 28px;
    height: 1px;
    background: var(--accent);
  }
  .projects-section {
    padding-block: 114px;
  }
  .home-projects {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 45px;
    align-items: start;
  }
  .home-project-2 {
    margin-top: 82px;
  }
  .project-image {
    aspect-ratio: 1.45;
    position: relative;
    overflow: hidden;
    background: #1b211d;
    border: 1px solid #ffffff12;
    padding: 36px;
    display: grid;
    align-items: center;
  }
  .home-project-2 .project-image {
    background: #211b17;
  }
  .project-open {
    position: absolute;
    top: 15px;
    right: 15px;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border: 1px solid #ffffff20;
    border-radius: 50%;
    transition:
      color 0.3s,
      background 0.3s;
  }
  .home-project:hover .project-open {
    background: var(--accent);
    color: var(--bg);
  }
  .project-caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-top: 22px;
  }
  .project-caption .eyebrow {
    font-size: 8px;
    margin-bottom: 10px;
  }
  .project-caption h3 {
    font-size: 30px;
  }
  .project-number {
    font-size: 11px;
    color: var(--muted);
  }
  .home-project > p {
    font-size: 11px;
    line-height: 1.8;
    color: var(--muted);
    max-width: 400px;
    margin-top: 13px;
  }
  .project-honesty {
    font-size: 10px;
    color: #969a8f;
    margin-top: 38px;
    max-width: 680px;
    line-height: 1.9;
  }
  .project-honesty span {
    color: var(--accent);
    margin-right: 7px;
  }
  .method-section {
    padding-block: 20px 115px;
  }
  .method-steps {
    list-style: none;
    margin: 50px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
  }
  .method-steps li {
    padding-right: 25px;
  }
  .method-number {
    font-family: var(--display);
    font-size: 43px;
    letter-spacing: -0.07em;
    color: #666d60;
  }
  .method-track {
    height: 32px;
    position: relative;
    display: flex;
    align-items: center;
    margin-top: 5px;
  }
  .method-track:before {
    content: '';
    height: 1px;
    background: #ffffff25;
    position: absolute;
    left: 0;
    right: -25px;
  }
  .method-steps li:last-child .method-track:before {
    right: 0;
  }
  .method-track i {
    display: block;
    width: 5px;
    height: 5px;
    background: var(--accent);
    z-index: 1;
  }
  .method-steps h3 {
    font-size: 21px;
    margin-block: 15px;
  }
  .method-steps p {
    font-size: 10px;
    line-height: 1.9;
    color: var(--muted);
    max-width: 190px;
  }
  .about-section {
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 110px;
    padding-block: 96px 113px;
    align-items: center;
  }
  .about-graphic {
    min-height: 350px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    background:
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 39px,
        #ffffff04 39px,
        #ffffff04 40px
      ),
      repeating-linear-gradient(
        90deg,
        transparent,
        transparent 39px,
        #ffffff04 39px,
        #ffffff04 40px
      );
  }
  .about-small,
  .about-coordinate {
    position: absolute;
    left: 20px;
    font-size: 7px;
    letter-spacing: 0.14em;
    color: #999e90;
  }
  .about-small {
    top: 20px;
  }
  .about-coordinate {
    bottom: 20px;
  }
  .about-monogram {
    position: relative;
    font: 400 165px/1 var(--display);
    letter-spacing: -0.11em;
    display: flex;
    color: #c4c7b4;
  }
  .about-monogram > span:first-child {
    transform: translateY(-18px);
  }
  .about-monogram > span:nth-child(2) {
    color: var(--accent);
    transform: translate(-8px, 18px);
  }
  .about-monogram i {
    font-style: normal;
    font-size: 46px;
    position: absolute;
    top: 1px;
    right: -29px;
    color: var(--accent);
  }
  .about-copy h2 {
    font-size: clamp(43px, 5vw, 69px);
    margin-bottom: 26px;
  }
  .about-copy > p:not(.section-label) {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.9;
    max-width: 390px;
  }
  .about-copy .text-link {
    margin-top: 25px;
  }
  @media (min-width: 1700px) {
    .hero {
      padding-top: 90px;
    }
    .hero-description {
      font-size: 15px;
      max-width: 420px;
    }
    .hero-actions .button {
      font-size: 13px;
