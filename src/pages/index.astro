---
import Layout from '../layouts/Layout.astro';
import MorphEngine from '../components/MorphEngine.astro';
import Arrow from '../components/Arrow.astro';
import ServiceVisual from '../components/ServiceVisual.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import { getServices } from '../content/services';
import { getPublishedProjects } from '../content/projects';
import { localeFromPath, translate, localizePath, getBrand } from '../i18n';
const locale = localeFromPath(Astro.url.pathname);
const t = (fr: string, en: string, es: string) => translate(locale, fr, en, es);
const brand = getBrand(locale);
const services = getServices(locale);
const publishedProjects = getPublishedProjects(locale);
const steps = [
  [
    t('Échange', 'Conversation', 'Conversación'),
    t(
      'Comprendre votre quotidien, vos enjeux et ce qui doit changer.',
      'Understand your day-to-day work, your challenges and what needs to change.',
      'Comprender tu día a día, tus retos y lo que debe cambiar.',
    ),
  ],
  [
    t('Cadrage', 'Scope', 'Alcance'),
    t(
      'Définir le bon périmètre, les priorités et les critères de réussite.',
      'Define the right scope, priorities and criteria for success.',
      'Definir el alcance adecuado, las prioridades y los criterios de éxito.',
    ),
  ],
  [
    t('Conception', 'Design', 'Diseño'),
    t(
      'Rendre la solution tangible avant de construire.',
      'Make the solution tangible before building it.',
      'Dar una forma concreta a la solución antes de construirla.',
    ),
  ],
  [
    t('Réalisation', 'Development', 'Desarrollo'),
    t(
      'Développer par étapes, avec des points de suivi concrets.',
      'Build in stages, with clear progress updates.',
      'Desarrollar por etapas, con puntos de seguimiento concretos.',
    ),
  ],
  [
    t('Validation', 'Validation', 'Validación'),
    t(
      'Tester ensemble, transmettre et vous rendre autonome.',
      'Test together, hand over and give you the tools to work independently.',
      'Probar juntos, transmitir el conocimiento y darte autonomía.',
    ),
  ],
];
---

<Layout
  title={t('Vos idées prennent forme', 'Your ideas take shape', 'Tus ideas toman forma')}
  description={brand.description}
>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow">
        <span class="status-dot"></span>
        {t(
          'Développeur indépendant · Toulouse',
          'Independent developer · Toulouse',
          'Desarrollador independiente · Toulouse',
        )}
      </p>
      <h1 id="hero-title">
        {t('Vos idées', 'Your ideas', 'Tus ideas')}
        <br />
        <span class="hero-emphasis">
          {t('prennent forme.', 'take shape.', 'toman forma.')}
          <svg viewBox="0 0 500 18" fill="none" aria-hidden="true">
            <path d="M2 13C111 1 218 2 285 9S425 16 498 5" stroke="currentColor" stroke-width="2" />
          </svg>
        </span>
      </h1>
      <p class="hero-description">
        <strong>
          {t(
            'Sites, applications, automatisation, data et intelligence artificielle.',
            'Websites, applications, automation, data and artificial intelligence.',
            'Sitios, aplicaciones, automatización, datos e inteligencia artificial.',
          )}
        </strong>
        {t(
          ' Je conçois les outils adaptés à votre activité.',
          ' I build tools that fit your business.',
          ' Diseño herramientas adaptadas a tu actividad.',
        )}
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href={localizePath('/contact', locale)}>
          {t('Parler de votre projet', 'Discuss your project', 'Hablar de tu proyecto')}
          <Arrow />
        </a>
        <a class="hero-secondary" href={localizePath('/realisations', locale)}>
          {t('Explorer les réalisations', 'Explore my work', 'Explorar los proyectos')}
          <Arrow diagonal={false} />
        </a>
      </div>
      <div class="hero-signature">
        <span class="signature-line"></span>
        <p>
          {brand.owner}
          <span>
            {t(
              'Des idées aux outils. Un seul interlocuteur.',
              'From ideas to tools. One point of contact.',
              'De las ideas a las herramientas. Un único interlocutor.',
            )}
          </span>
        </p>
      </div>
    </div>
    <div class="hero-art">
      <MorphEngine />
    </div>
    <div class="hero-bottom">
      <a href={localizePath('/#expertises', locale)} class="discover-link">
        <span>↓</span>{' '}
        {t(
          'DÉCOUVRIR CE QUE L’ON PEUT CONSTRUIRE',
          'EXPLORE WHAT WE CAN BUILD',
          'DESCUBRE LO QUE PODEMOS CONSTRUIR',
        )}
      </a>
      <span>
        {t(
          'DE L’IDÉE À L’OUTIL. SANS DÉTOUR.',
          'FROM IDEA TO TOOL. A DIRECT PATH.',
          'DE LA IDEA A LA HERRAMIENTA. SIN RODEOS.',
        )}
      </span>
    </div>
  </section>
  <div class="expertise-ribbon" aria-hidden="true">
    <div class="container">
      <span>{t('CONCEVOIR', 'DESIGN', 'DISEÑAR')}</span>
      <i>↗</i>
      <span>{t('CONNECTER', 'CONNECT', 'CONECTAR')}</span>
      <i>↗</i>
      <span>{t('AUTOMATISER', 'AUTOMATE', 'AUTOMATIZAR')}</span>
      <i>↗</i>
      <span>{t('TRANSFORMER', 'TRANSFORM', 'TRANSFORMAR')}</span>
      <i>↗</i>
    </div>
  </div>
  <section class="expertise-section container" id="expertises">
    <div class="section-heading">
      <div>
        <p class="section-label">01 / {t('Expertises', 'Services', 'Servicios')}</p>
        <h2 data-reveal>
          {t('La bonne technologie.', 'The right technology.', 'La tecnología adecuada.')}
          <br />
          <span class="muted-heading">
            {t('Pour votre vrai besoin.', 'For your actual needs.', 'Para tu necesidad real.')}
          </span>
        </h2>
      </div>
      <p class="section-intro">
        {t(
          'Un site qui vous ressemble. Des tâches qui s’exécutent seules. Des données qui deviennent utiles. On part de votre quotidien.',
          'A website that reflects who you are. Tasks that run automatically. Data that becomes useful. It starts with your day-to-day work.',
          'Un sitio que refleja quién eres. Tareas que se ejecutan solas. Datos que se vuelven útiles. Partimos de tu día a día.',
        )}
      </p>
    </div>
    <div class="service-list">
      {services.map((service, i) => (
        <a
          class="service-row"
          href={localizePath(`/services/${service.slug}`, locale)}
          data-service-card
          data-service-index={i}
        >
          <div class="service-number">
            0{i + 1}
            <span>↘</span>
          </div>
          <div class="service-copy">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <div class="service-tags">
              {service.tags.slice(0, 3).map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
          </div>
          <div class="service-visual">
            <ServiceVisual kind={(['web', 'automation', 'data', 'ai'] as const)[i]!} />
          </div>
          <span class="service-link-icon">
            <Arrow />
          </span>
        </a>
      ))}
    </div>
  </section>
  <section class="transformation-section" aria-labelledby="transformation-title">
    <div class="container transformation-grid">
      <div>
        <p class="section-label">{t('L’approche', 'The approach', 'El enfoque')}</p>
        <h2 id="transformation-title" data-reveal>
          {t('Moins de friction.', 'Less friction.', 'Menos obstáculos.')}
          <br />
          <em>{t('Plus de possibilités.', 'More possibilities.', 'Más posibilidades.')}</em>
        </h2>
        <p>
          {t(
            'La technologie a du sens lorsqu’elle simplifie quelque chose. Je relie vos idées, vos outils et vos données pour en faire un ensemble qui fonctionne.',
            'Technology makes sense when it simplifies something. I connect your ideas, tools and data so they work together.',
            'La tecnología tiene sentido cuando simplifica algo. Conecto tus ideas, tus herramientas y tus datos para que funcionen juntos.',
          )}
        </p>
      </div>
      <div class="system-story" data-story>
        <div class="story-step">
          <span class="story-index">01</span>
          <div>
            <span class="eyebrow">
              {t('Le point de départ', 'The starting point', 'El punto de partida')}
            </span>
            <h3>{t('Un besoin', 'A need', 'Una necesidad')}</h3>
            <div class="story-fragments" aria-hidden="true">
              <i></i>
              <i></i>
              <i></i>
              <i></i>
              <i></i>
              <i></i>
            </div>
          </div>
        </div>
        <div class="story-step">
          <span class="story-index">02</span>
          <div>
            <span class="eyebrow">
              {t('Les bonnes connexions', 'The right connections', 'Las conexiones adecuadas')}
            </span>
            <h3>{t('Un système', 'A system', 'Un sistema')}</h3>
            <div class="story-system" aria-hidden="true">
              <i></i>
              <span></span>
              <i></i>
              <span></span>
              <i></i>
            </div>
          </div>
        </div>
        <div class="story-step">
          <span class="story-index">03</span>
          <div>
            <span class="eyebrow">
              {t('Dans votre quotidien', 'In your daily work', 'En tu día a día')}
            </span>
            <h3>{t('Un résultat utilisable', 'A useful result', 'Un resultado útil')}</h3>
            <p>
              {t(
                'Clair. Fiable. À votre mesure.',
                'Clear. Reliable. Made for you.',
                'Claro. Fiable. A tu medida.',
              )}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="projects-section container">
    <div class="section-heading">
      <div>
        <p class="section-label">
          02 / {t('La preuve par le concret', 'See it working', 'La prueba en la práctica')}
        </p>
        <h2 data-reveal>
          {t('Des idées.', 'Ideas.', 'Ideas.')}
          <br />
          <span class="muted-heading">
            {t('Déjà en action.', 'Already in action.', 'Ya en acción.')}
          </span>
        </h2>
      </div>
      <a class="text-link" href={localizePath('/realisations', locale)}>
        {t('Toutes les réalisations', 'All projects', 'Todos los proyectos')}
        <Arrow />
      </a>
    </div>
    <div class="home-projects">
      {publishedProjects.slice(0, 2).map((project, i) => (
        <a
          class:list={['home-project', `home-project-${i + 1}`]}
          href={localizePath(project.href, locale)}
        >
          <div class="project-image" data-project-image transition:name={`project-${project.slug}`}>
            <ProjectPreview project={project} />
            <span class="project-open" aria-hidden="true">
              <Arrow />
            </span>
          </div>
          <div class="project-caption">
            <div>
              <span class="eyebrow">
                {project.type} · {project.category}
              </span>
              <h3>{project.title}</h3>
            </div>
            <span class="project-number">0{i + 1}</span>
          </div>
          <p>{project.summary}</p>
        </a>
      ))}
    </div>
    <p class="project-honesty">
      <span>↳</span>{' '}
      {t(
        'Des démonstrateurs interactifs à explorer, construits avec des données fictives. Aucun résultat client revendiqué.',
        'Interactive demos built with fictional data for you to explore. No client results are claimed.',
        'Demostraciones interactivas que puedes explorar, creadas con datos ficticios. No se atribuyen resultados de clientes.',
      )}
    </p>
  </section>
  <section class="method-section container">
    <div class="section-heading">
      <div>
        <p class="section-label">
          03 /{' '}
          {t(
            'Du premier échange à la livraison',
            'From the first conversation to delivery',
            'De la primera conversación a la entrega',
          )}
        </p>
        <h2 data-reveal>
          {t('Un chemin clair.', 'A clear path.', 'Un camino claro.')}
          <br />
          <span class="muted-heading">
            {t('À chaque étape.', 'At every stage.', 'En cada etapa.')}
          </span>
        </h2>
      </div>
      <p class="section-intro">
        {t(
          'Vous savez où l’on va, ce qui avance et pourquoi. Je reste votre interlocuteur tout au long du projet.',
          'You know where we are heading, what is moving forward and why. I remain your point of contact throughout the project.',
          'Sabes adónde vamos, qué avanza y por qué. Soy tu interlocutor durante todo el proyecto.',
        )}
      </p>
    </div>
    <ol class="method-steps">
      {steps.map(([title, description], i) => (
        <li data-method-step>
          <span class="method-number">0{i + 1}</span>
          <div class="method-track">
            <i></i>
          </div>
          <h3>{title}</h3>
          <p>{description}</p>
        </li>
      ))}
    </ol>
  </section>
  <section class="about-section container">
    <div class="about-graphic" aria-hidden="true">
      <span class="about-small">
        {t(
          'UNE PERSONNE. UN FIL CONDUCTEUR.',
          'ONE PERSON. A CONNECTING THREAD.',
          'UNA PERSONA. UN HILO CONDUCTOR.',
        )}
      </span>
      <svg class="about-flow" viewBox="0 0 520 350" fill="none">
        <path
          d="M-24 283C108 354 122 67 272 94S419 318 551 183"
          stroke="var(--accent-solid)"
          stroke-width="34"
        />
        <path
          d="M-24 273C108 344 122 57 272 84S419 308 551 173"
          stroke="var(--accent-hover)"
          stroke-width="1.5"
        />
      </svg>
      <p class="about-name">{brand.owner}</p>
      <span class="about-coordinate">{brand.location}</span>
    </div>
    <div class="about-copy">
      <p class="section-label">
        04 / {t('Derrière les outils', 'Behind the tools', 'Detrás de las herramientas')}
      </p>
      <h2 data-reveal>
        {t('Paul, tout', 'Simply', 'Paul,')}
        <br />
        {t('simplement.', 'Paul.', 'sin más.')}
      </h2>
      <p>
        {t(
          'J’aime comprendre comment les choses fonctionnent. Et trouver comment les faire mieux fonctionner ensemble.',
          'I like understanding how things work, and finding ways to make them work better together.',
          'Me gusta comprender cómo funcionan las cosas y encontrar cómo hacer que funcionen mejor juntas.',
        )}
      </p>
      <p>
        {t(
          'Titulaire d’un master (Bac+5), je suis ingénieur en automatisation des systèmes et en intelligence artificielle, et data scientist. Mon parcours comprend deux ans au bureau d’études de Prooftag.',
          'I hold a master’s degree (Bac+5) and work as a systems automation and AI engineer and data scientist. My experience includes two years in Prooftag’s engineering department.',
          'Tengo un máster (Bac+5) y soy ingeniero en automatización de sistemas e inteligencia artificial, y científico de datos. Mi trayectoria incluye dos años en la oficina técnica de Prooftag.',
        )}
      </p>
      <a class="text-link" href={localizePath('/a-propos', locale)}>
        {t('Un peu plus sur moi', 'A little more about me', 'Un poco más sobre mí')}
        <Arrow />
      </a>
    </div>
  </section>
</Layout>
<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 1.06fr 1fr;
    align-items: center;
    padding-top: 72px;
    column-gap: 0;
  }
  .hero-copy {
    position: relative;
    z-index: 3;
    padding-bottom: 22px;
  }
  .hero-eyebrow {
    font-size: 9px;
    letter-spacing: 0.14em;
    margin-bottom: 32px;
  }
  .hero h1 {
    font-size: clamp(52px, 6vw, 91px);
    line-height: 1.045;
    letter-spacing: -0.064em;
    white-space: nowrap;
  }
  .hero-emphasis {
    position: relative;
    color: var(--accent);
  }
  .hero-emphasis svg {
    position: absolute;
    left: 0;
    bottom: -12px;
    width: 100%;
    height: 13px;
    overflow: visible;
    opacity: 0.7;
  }
  .hero-description {
    font-size: 15px;
    line-height: 1.9;
    color: var(--muted);
    max-width: 395px;
    margin-top: 36px;
  }
  .hero-description strong {
    font-weight: 500;
    color: var(--ink);
  }
  .hero-actions {
    display: flex;
    gap: 23px;
    align-items: center;
    margin-top: 29px;
  }
  .hero-actions .button {
    gap: 23px;
    font-size: 11px;
    min-height: 51px;
    padding-inline: 20px;
  }
  .hero-secondary {
    display: flex;
    gap: 12px;
    align-items: center;
    min-height: 44px;
    font-size: 10px;
    white-space: nowrap;
  }
  .hero-secondary svg {
    width: 15px;
  }
  .hero-signature {
    display: flex;
    gap: 15px;
    align-items: center;
    margin-top: 44px;
  }
  .signature-line {
    width: 25px;
    height: 1px;
    background: var(--accent);
  }
  .hero-signature p {
    font-size: 10px;
  }
  .hero-signature p span {
    display: block;
    font-size: 9px;
    margin-top: 3px;
    color: var(--muted);
  }
  .hero-art {
    min-width: 0;
    margin-left: 5px;
    position: relative;
  }
  .hero-bottom {
    grid-column: 1/-1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 55px;
    padding-bottom: 27px;
    color: var(--muted);
    font-size: 7px;
    letter-spacing: 0.13em;
  }
  .discover-link {
    display: flex;
    gap: 12px;
    align-items: center;
    min-height: 30px;
  }
  .discover-link > span {
    font-size: 18px;
    color: var(--ink);
  }
  .expertise-ribbon {
    border-block: 1px solid var(--line);
    background: var(--surface-deep);
  }
  .expertise-ribbon > .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding-block: 25px;
    font: 400 clamp(15px, 1.65vw, 24px)/1 var(--display);
    letter-spacing: -0.035em;
    color: var(--muted);
  }
  .expertise-ribbon i {
    font-style: normal;
    color: var(--accent);
    font-size: 24px;
  }
  .expertise-section {
    padding-block: 116px 110px;
  }
  .section-label {
    margin-bottom: 26px;
  }
  .muted-heading {
    color: var(--muted);
  }
  .section-intro {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.9;
    max-width: 290px;
    padding-bottom: 5px;
  }
  .service-list {
    border-top: 1px solid var(--border-control);
  }
  .service-row {
    display: grid;
    grid-template-columns: 70px 1fr 260px 38px;
    gap: 25px;
    align-items: center;
    border-bottom: 1px solid var(--line);
    padding: 35px 0;
    position: relative;
    min-height: 185px;
    transition: background 0.3s;
  }
  .service-row:before {
    content: '';
    position: absolute;
    inset: 0 -20px;
    background: var(--surface-hover);
    opacity: 0;
    transition: opacity 0.3s;
    z-index: -1;
  }
  .service-row:hover:before,
  .service-row:focus-visible:before {
    opacity: 1;
  }
  .service-number {
    align-self: start;
    color: var(--muted);
    font-size: 11px;
    padding-top: 9px;
    display: flex;
    flex-direction: column;
    gap: 38px;
  }
  .service-number span {
    color: var(--muted);
    font-size: 20px;
  }
  .service-copy h3 {
    font-size: clamp(27px, 2.8vw, 42px);
    margin-bottom: 14px;
    transition: color 0.3s;
  }
  .service-row:hover h3,
  .service-row:focus-visible h3 {
    color: var(--accent);
  }
  .service-copy p {
    max-width: 460px;
    font-size: 13px;
    color: var(--muted);
    line-height: 1.9;
  }
  .service-tags {
    display: flex;
    gap: 15px;
    margin-top: 20px;
    color: var(--muted);
    font-size: 8px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .service-visual {
    height: 115px;
    max-width: 230px;
    opacity: 0.75;
    transition: opacity 0.3s;
  }
  .service-row:hover .service-visual,
  .service-row:focus-visible .service-visual {
    opacity: 1;
  }
  .service-link-icon {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    transition:
      background 0.3s,
      color 0.3s;
  }
  .service-row:hover .service-link-icon,
  .service-row:focus-visible .service-link-icon {
    background: var(--accent);
    color: var(--bg);
  }
  .transformation-section {
    background: var(--surface);
    border-block: 1px solid var(--line);
    padding-block: 96px;
  }
  .transformation-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 100px;
    align-items: center;
  }
  .transformation-grid > div > p:last-child {
    font-size: 13px;
    max-width: 390px;
    color: var(--muted);
    line-height: 1.9;
    margin-top: 28px;
  }
  .transformation-grid h2 {
    font-size: clamp(36px, 4.5vw, 60px);
  }
  .system-story {
    padding-left: 30px;
  }
  .story-step {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 15px;
    position: relative;
    padding-bottom: 34px;
  }
  .story-step:before {
    content: '';
    position: absolute;
    left: 16px;
    top: 33px;
    bottom: 0;
    width: 1px;
    background: var(--accent-soft);
  }
  .story-step:last-child {
    padding-bottom: 0;
  }
  .story-step:last-child:before {
    display: none;
  }
  .story-index {
    font-size: 9px;
    display: grid;
    place-items: center;
    width: 33px;
    height: 33px;
    border: 1px solid var(--accent-line);
    border-radius: 50%;
    color: var(--accent);
  }
  .story-step .eyebrow {
    font-size: 7px;
    margin-bottom: 7px;
  }
  .story-step h3 {
    font-size: 27px;
  }
  .story-step p {
    color: var(--muted);
    font-size: 10px;
    margin-top: 10px;
  }
  .story-fragments,
  .story-system {
    height: 36px;
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 12px;
  }
  .story-fragments i {
    width: 22px;
    height: 18px;
    border: 1px solid var(--accent);
    border-radius: 80% 12% 70% 10%;
