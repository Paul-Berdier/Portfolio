---
import Layout from '../layouts/Layout.astro';
import {
  sampleCsv,
  normalizeCsv,
  sampleSummary,
  sampleDocuments,
  formatAmount,
  dataCategories,
} from '../content/lab';
import { localeFromPath, localizePath, translate } from '../i18n';
import { getLabMessages, labCategoryLabel } from '../i18n/lab';
export const prerender = true;
const locale = localeFromPath(Astro.url.pathname);
const t = (fr: string, en: string, es: string) => translate(locale, fr, en, es);
const messages = getLabMessages(locale);
const sampleData = normalizeCsv(sampleCsv, locale);
const categoryLabel = (category: string) => labCategoryLabel(category, locale);
const amount = (value: number) => formatAmount(value, locale);
---

<Layout
  title={t(
    'Le lab — Deux expériences à manipuler',
    'The lab — Two hands-on experiments',
    'El laboratorio — Dos experiencias interactivas',
  )}
  description={t(
    'Transformez un petit CSV et déclenchez un workflow de documents : deux démonstrateurs locaux avec des données synthétiques, sans compte ni transmission.',
    'Transform a small CSV and run a document workflow: two local demos with synthetic data, no account or data transfer required.',
    'Transforma un pequeño CSV y ejecuta un flujo documental: dos demos locales con datos sintéticos, sin cuenta ni envío de datos.',
  )}
>
  <div class="container page-shell">
    <header class="page-heading">
      <p class="eyebrow">
        {t(
          'Le lab / Expériences ouvertes',
          'The lab / Open experiments',
          'El laboratorio / Experiencias abiertas',
        )}
      </p>
      <h1 data-line>
        {t('Moins de promesses.', 'Fewer promises.', 'Menos promesas.')}
        <br />
        <em>{t('À vous de jouer.', 'Try it yourself.', 'Pruébalo tú.')}</em>
      </h1>
      <p class="lede">
        {t(
          'Deux petites expériences pour voir une idée devenir un outil. Modifiez une entrée. Lancez une action. Observez ce qui change.',
          'Two small experiments to see an idea become a tool. Change an input. Run an action. See what happens.',
          'Dos pequeñas experiencias para ver cómo una idea se convierte en una herramienta. Modifica un dato. Ejecuta una acción. Observa qué cambia.',
        )}
      </p>
      <div class="lab-notes">
        <span>
          <i></i>
          {t('Dans votre navigateur', 'In your browser', 'En tu navegador')}
        </span>
        <span>{t('Données synthétiques', 'Synthetic data', 'Datos sintéticos')}</span>
        <span>{t('Aucun compte requis', 'No account required', 'Sin necesidad de cuenta')}</span>
      </div>
    </header>
    <nav
      class="lab-jump"
      aria-label={t('Choisir une expérience', 'Choose an experiment', 'Elegir una experiencia')}
    >
      <a href="#data">
        <span>01</span> {t('L’atelier data', 'Data workbench', 'Taller de datos')}{' '}
        <span aria-hidden="true">↓</span>
      </a>
      <a href="#workflow">
        <span>02</span> {t('Le flux documentaire', 'Document workflow', 'Flujo documental')}{' '}
        <span aria-hidden="true">↓</span>
      </a>
    </nav>
    <noscript>
      <p class="notice">
        {t(
          'Les jeux de données et leur explication restent lisibles. Activez JavaScript pour modifier les données et exécuter les expériences.',
          'The datasets and their explanations remain readable. Enable JavaScript to edit the data and run the experiments.',
          'Los datos y sus explicaciones siguen siendo legibles. Activa JavaScript para modificar los datos y ejecutar las experiencias.',
        )}
      </p>
    </noscript>
    <section id="data" class="lab-section" data-data-lab>
      <header class="lab-heading" data-reveal>
        <p class="eyebrow">01 / {t('Data', 'Data', 'Datos')}</p>
        <h2>
          {t('Du brut', 'From raw data', 'De datos en bruto')}
          <br />
          <em>{t('au lisible.', 'to a clear view.', 'a una vista clara.')}</em>
        </h2>
        <p>
          {t(
            'Un petit CSV comporte des variations de casse, un doublon et des entrées invalides. Le traitement harmonise les valeurs, écarte les anomalies et calcule une vue par catégorie.',
            'A small CSV contains inconsistent letter case, a duplicate and invalid entries. Processing standardises the values, excludes invalid rows and calculates a view by category.',
            'Un pequeño CSV contiene variaciones de mayúsculas, un duplicado y entradas no válidas. El proceso unifica los valores, descarta las anomalías y calcula una vista por categoría.',
          )}
        </p>
      </header>
      <div class="data-workspace" data-reveal>
        <form class="source-panel" data-data-form>
          <div class="panel-header">
            <span>{t('01 — LA MATIÈRE', '01 — THE INPUT', '01 — LOS DATOS')}</span>
            <span>CSV / UTF-8</span>
          </div>
          <label for="lab-csv">
            {t('Votre jeu de données', 'Your dataset', 'Tu conjunto de datos')}
          </label>
          <textarea
            id="lab-csv"
            name="csv"
            rows="12"
            spellcheck="false"
            maxlength="20000"
            aria-describedby="csv-help"
            data-csv-input
          >{sampleCsv}</textarea>
          <p id="csv-help" class="field-help">
            {t(
              'Séparateur « ; ». Catégories : web, data, automatisation. Montants positifs, jusqu’à 2 décimales. 100 lignes maximum. Utilisez uniquement des données fictives.',
              'Use “;” as the separator. Keep the CSV header id;categorie;montant and category values web, data, automatisation. Non-negative amounts, up to 2 decimal places. Maximum 100 rows. Use fictional data only.',
              'Usa «;» como separador. Conserva la cabecera id;categorie;montant y los valores de categoría web, data, automatisation. Importes no negativos, con hasta 2 decimales. Máximo 100 filas. Utiliza solo datos ficticios.',
            )}
          </p>
          <div class="source-actions">
            <button type="submit" class="button button-primary" data-normalize disabled>
              {t('Transformer', 'Transform', 'Transformar')} <span aria-hidden="true">↗</span>
            </button>
            <button type="button" class="reset-button" data-reset-csv disabled>
              {t('Réinitialiser', 'Reset', 'Restablecer')}
            </button>
          </div>
        </form>
        <div class="result-panel">
          <div class="panel-header">
            <span>{t('02 — LA LECTURE', '02 — THE VIEW', '02 — LA VISTA')}</span>
            <span>{t('CALCUL LOCAL', 'LOCAL CALCULATION', 'CÁLCULO LOCAL')}</span>
          </div>
          <div class="result-controls">
            <label for="lab-category">{t('Catégorie', 'Category', 'Categoría')}</label>
            <select id="lab-category" data-data-filter disabled>
              <option value="all">
                {t('Toutes les catégories', 'All categories', 'Todas las categorías')}
              </option>
              {dataCategories.map((category) => (
                <option value={category}>{categoryLabel(category)}</option>
              ))}
            </select>
          </div>
          <div class="data-stats">
            <div>
              <strong data-stat-valid>{sampleData.rows.length}</strong>
              <span>{t('lignes valides', 'valid rows', 'filas válidas')}</span>
            </div>
            <div>
              <strong data-stat-duplicate>{sampleData.duplicateCount}</strong>
              <span>{t('doublon', 'duplicate', 'duplicado')}</span>
            </div>
            <div>
              <strong data-stat-invalid>{sampleData.invalidCount}</strong>
              <span>{t('anomalies', 'invalid entries', 'anomalías')}</span>
            </div>
          </div>
          <div
            class="lab-chart"
            data-data-chart
            role="img"
            aria-label={`${messages.chartLabel} : ${sampleSummary.map((item) => `${categoryLabel(item.category)} : ${amount(item.amount)} euros`).join(', ')}`}
          >
            {sampleSummary.map((item) => (
              <div class="lab-chart-row" data-chart-category={item.category}>
                <span>{categoryLabel(item.category)}</span>
                <div class="lab-chart-track">
                  <div
                    class="lab-chart-bar"
                    data-chart-bar
                    style={`width:${(item.amount / 2100) * 100}%`}
                  ></div>
                </div>
                <strong data-chart-value>{amount(item.amount)} €</strong>
              </div>
            ))}
          </div>
          <p class="chart-caption">
            {t(
              'Montants fictifs agrégés à partir des lignes retenues.',
              'Fictional amounts aggregated from the accepted rows.',
              'Importes ficticios agregados a partir de las filas aceptadas.',
            )}
          </p>
          <p class="lab-status" role="status" aria-live="polite" data-data-status>
            {t(
              'Le jeu fourni : 9 lignes, 6 retenues. Modifiez le CSV pour tester les règles.',
              'The sample has 9 rows, with 6 accepted. Edit the CSV to test the rules.',
              'El ejemplo contiene 9 filas, de las que se aceptan 6. Modifica el CSV para probar las reglas.',
            )}
          </p>
          <details class="issues">
            <summary>
              {t(
                'Détail des lignes écartées',
                'Excluded row details',
                'Detalle de las filas descartadas',
              )}
            </summary>
            <ul data-data-issues>
              {sampleData.issues.map((issue) => (
                <li>{issue}</li>
              ))}
            </ul>
          </details>
        </div>
      </div>
      <details class="data-table-details">
        <summary>
          {t('Voir les lignes retenues', 'View accepted rows', 'Ver las filas aceptadas')}{' '}
          <span aria-hidden="true">↗</span>
        </summary>
        <div class="table-scroll">
          <table>
            <caption>
              {t(
                'Lignes normalisées, selon le filtre actif',
                'Normalised rows, using the current filter',
                'Filas normalizadas según el filtro activo',
              )}
            </caption>
            <thead>
              <tr>
                <th scope="col">{t('Identifiant', 'Identifier', 'Identificador')}</th>
                <th scope="col">{t('Catégorie', 'Category', 'Categoría')}</th>
                <th scope="col">
                  {t('Montant synthétique', 'Synthetic amount', 'Importe sintético')}
                </th>
              </tr>
            </thead>
            <tbody data-data-rows>
              {sampleData.rows.map((row) => (
                <tr>
                  <td>{row.id}</td>
                  <td>{categoryLabel(row.category)}</td>
                  <td>{amount(row.amount)} €</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
      <div class="lab-bottom">
        <p>
          {t(
            'Les règles sont explicites : catégories harmonisées, première occurrence d’un identifiant conservée, entrées invalides signalées. Aucun fichier n’est envoyé ou enregistré.',
            'The rules are explicit: standardised categories, the first valid occurrence of each identifier kept, invalid entries flagged. No files are sent or saved.',
            'Las reglas son explícitas: categorías unificadas, primera aparición válida de cada identificador conservada y entradas no válidas señaladas. No se envía ni se guarda ningún archivo.',
          )}
        </p>
        <a href={localizePath('/realisations/atelier-data', locale)} class="text-link">
          {t('Lire l’étude de cas', 'Read the case study', 'Leer el caso práctico')}{' '}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
    <section id="workflow" class="lab-section workflow-section" data-workflow-lab>
      <header class="lab-heading" data-reveal>
        <p class="eyebrow">02 / {t('Automatisation', 'Automation', 'Automatización')}</p>
        <h2>
          {t('Une action.', 'One action.', 'Una acción.')}
          <br />
          <em>{t('Un chemin clair.', 'A clear path.', 'Un camino claro.')}</em>
        </h2>
        <p>
          {t(
            'Déclenchez une suite d’opérations sur trois objets synthétiques. Le programme vérifie leurs champs, les oriente et prépare un export que vous pouvez télécharger.',
            'Run a sequence of operations on three synthetic objects. The program checks their fields, routes them and prepares an export you can download.',
            'Ejecuta una secuencia de operaciones sobre tres objetos sintéticos. El programa comprueba sus campos, los clasifica y prepara una exportación descargable.',
          )}
        </p>
      </header>
      <div class="workflow-workspace" data-reveal>
        <div class="panel-header">
          <span>{t('DOCUMENT FLOW', 'DOCUMENT FLOW', 'FLUJO DOCUMENTAL')}</span>
          <span>{t('EXÉCUTION LOCALE', 'LOCAL EXECUTION', 'EJECUCIÓN LOCAL')}</span>
        </div>
        <ol class="workflow-steps">
          {messages.steps.map((step, index) => (
            <li data-workflow-step>
              <span class="step-number">0{index + 1}</span>
              <div>
                <h3>{step.label}</h3>
                <p>{step.detail}</p>
                <span class="step-state" data-step-state>
                  {messages.idle}
                </span>
              </div>
            </li>
          ))}
        </ol>
        <div class="workflow-options">
          <label>
            <input type="checkbox" data-workflow-valid />{' '}
            {t(
              'Utiliser un jeu entièrement valide',
              'Use a fully valid dataset',
              'Usar un conjunto de datos completamente válido',
            )}
          </label>
          <div class="workflow-actions">
            <button type="button" class="button button-primary" data-run-workflow disabled>
              {t('Lancer le flux', 'Run the workflow', 'Ejecutar el flujo')}{' '}
              <span aria-hidden="true">↗</span>
            </button>
            <button type="button" class="button button-secondary" data-download-workflow disabled>
              {t('Télécharger le JSON', 'Download the JSON', 'Descargar el JSON')}{' '}
              <span aria-hidden="true">↓</span>
            </button>
          </div>
        </div>
        <p class="lab-status workflow-status" role="status" aria-live="polite" data-workflow-status>
          {t(
            'Prêt à traiter trois objets synthétiques. Aucun fichier PDF n’est réellement lu.',
            'Ready to process three synthetic objects. No actual PDF files are read.',
            'Todo listo para procesar tres objetos sintéticos. No se lee ningún archivo PDF real.',
          )}
        </p>
        <div class="table-scroll">
          <table class="workflow-table">
            <caption>
              {t(
                'Documents synthétiques et décisions de traitement',
                'Synthetic documents and processing decisions',
                'Documentos sintéticos y decisiones de procesamiento',
              )}
            </caption>
            <thead>
              <tr>
                <th scope="col">
                  {t('Document représenté', 'Sample document', 'Documento de ejemplo')}
                </th>
                <th scope="col">{t('Montant', 'Amount', 'Importe')}</th>
                <th scope="col">{t('Destination', 'Destination', 'Destino')}</th>
              </tr>
            </thead>
            <tbody data-workflow-results>
              {sampleDocuments.map((doc) => (
                <tr>
                  <td>
                    {doc.name}
                    <small>
                      {doc.reference ||
                        t('Référence absente', 'Missing reference', 'Sin referencia')}
                    </small>
                  </td>
                  <td>{amount(doc.amount)} €</td>
                  <td>{messages.pending}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <div class="lab-bottom">
        <p>
          {t(
            'Ce démonstrateur traite des objets JavaScript. Il ne lit pas de PDF, n’envoie pas de document et ne se connecte à aucun logiciel. L’animation rend visible un calcul effectué localement.',
            'This demo processes JavaScript objects. It does not read PDFs, send documents or connect to any software. The animation shows a calculation performed locally.',
            'Esta demo procesa objetos JavaScript. No lee PDF, no envía documentos ni se conecta a ningún programa. La animación muestra un cálculo realizado localmente.',
          )}
        </p>
        <a href={localizePath('/realisations/flux-documents', locale)} class="text-link">
          {t('Lire l’étude de cas', 'Read the case study', 'Leer el caso práctico')}{' '}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
    <section class="lab-cta" data-reveal>
      <p class="eyebrow">
        {t('Passer à votre cas', 'Apply it to your project', 'Aplicarlo a tu proyecto')}
      </p>
      <h2>
        {t('Le même principe.', 'The same principle.', 'El mismo principio.')}
        <br />
        <em>
          {t('Votre propre matière.', 'Your own starting point.', 'Tu propio punto de partida.')}
        </em>
      </h2>
      <p>
        {t(
          'Vos données, vos étapes, vos contraintes. Parlons de ce qui mérite d’être simplifié.',
          'Your data, your steps, your constraints. Let’s discuss what could be simpler.',
          'Tus datos, tus etapas, tus límites. Hablemos de lo que se podría simplificar.',
        )}
      </p>
      <a href={localizePath('/contact', locale)} class="button button-primary">
        {t('Parler de votre projet', 'Discuss your project', 'Hablar de tu proyecto')}{' '}
        <span aria-hidden="true">↗</span>
      </a>
    </section>
  </div>
</Layout>
<style>
  h1 em,
  h2 em {
    font-style: normal;
    color: var(--accent);
  }
  .lab-notes {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 27px;
    margin-top: 35px;
    color: var(--muted);
    font-size: 11px;
  }
  .lab-notes span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .lab-notes i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--success);
  }
  .lab-jump {
    display: flex;
    gap: 45px;
    padding: 24px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .lab-jump a {
    color: var(--ink);
    display: flex;
    gap: 15px;
    font-size: 14px;
    text-decoration: none;
  }
  .lab-jump a span:first-child {
    color: var(--accent);
    font-size: 10px;
  }
  .lab-jump a span:last-child {
    margin-left: 20px;
  }
  .lab-section {
    padding-top: 100px;
    scroll-margin-top: 100px;
  }
  .lab-heading {
    display: grid;
    grid-template-columns: 0.65fr 1.15fr 1fr;
    gap: 5%;
    align-items: start;
    margin-bottom: 45px;
  }
  .lab-heading h2 {
    font-size: clamp(38px, 5vw, 66px);
    letter-spacing: -0.06em;
    line-height: 1.07;
  }
  .lab-heading > p:last-child {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.8;
    margin: 0;
  }
  .data-workspace {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    border: 1px solid var(--line);
    background: var(--surface);
    border-radius: 12px 12px 0 0;
    overflow: hidden;
  }
  .source-panel,
  .result-panel {
    padding: 28px;
    min-width: 0;
  }
  .source-panel {
    border-right: 1px solid var(--line);
    background: var(--surface-deep);
  }
  .panel-header {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    color: var(--muted);
    font: 9px monospace;
    letter-spacing: 0.1em;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 24px;
  }
  .source-panel label,
  .result-controls label {
    display: block;
    font-size: 12px;
    color: var(--ink);
    margin-bottom: 12px;
  }
  .source-panel textarea {
    width: 100%;
    min-height: 265px;
    padding: 18px;
    border: 1px solid var(--border-control);
    background: var(--bg);
    color: var(--ink);
    border-radius: 8px;
    font: 12px/1.8 monospace;
    resize: vertical;
    box-sizing: border-box;
  }
  .field-help {
    font-size: 11px;
    line-height: 1.7;
    color: var(--muted);
    margin: 12px 0 22px;
  }
  .source-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
  .reset-button {
    border: 0;
    background: transparent;
    color: var(--muted);
    padding: 9px 0;
    font: inherit;
    font-size: 12px;
    text-decoration: underline;
    cursor: pointer;
  }
  .result-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
  }
  .result-controls label {
    margin: 0;
  }
  .result-controls select {
    max-width: 230px;
    background: var(--surface-raised);
    color: var(--ink);
    border: 1px solid var(--border-control);
    padding: 10px 30px 10px 10px;
    font: inherit;
    font-size: 11px;
    border-radius: 7px;
  }
  .data-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    padding: 32px 0;
  }
  .data-stats strong {
    display: block;
    font-weight: 400;
    font-size: 43px;
    letter-spacing: -0.06em;
  }
  .data-stats span {
    display: block;
    color: var(--muted);
    font-size: 10px;
    margin-top: 4px;
  }
  .data-stats > div:first-child strong {
    color: var(--success);
  }
  .data-stats > div:last-child strong {
    color: var(--accent);
  }
  .lab-chart {
    margin: 12px 0 0;
  }
  .lab-chart-row {
    display: grid;
    grid-template-columns: 91px minmax(25px, 1fr) 75px;
    align-items: center;
    gap: 12px;
    margin: 23px 0;
  }
  .lab-chart-row > span {
    font-size: 10px;
    color: var(--muted);
  }
  .lab-chart-row strong {
    font: 10px monospace;
    text-align: right;
    white-space: nowrap;
  }
  .lab-chart-track {
    height: 22px;
    background: var(--surface-hover);
    border-radius: 0 5px 5px 0;
    overflow: hidden;
  }
  .lab-chart-bar {
    background: var(--chart-web);
    height: 100%;
  }
  .lab-chart-row:nth-child(2) .lab-chart-bar {
    background: var(--chart-data);
  }
  .lab-chart-row:nth-child(3) .lab-chart-bar {
    background: var(--chart-automation);
  }
  .chart-caption {
    color: var(--muted);
    font-size: 10px;
    line-height: 1.7;
    margin-bottom: 30px;
  }
  .lab-status {
    font-size: 12px;
    color: var(--muted);
    border-top: 1px solid var(--line);
    line-height: 1.8;
    padding-top: 17px;
    margin-bottom: 15px;
  }
  .lab-status[data-state='error'] {
    color: var(--error);
  }
  .issues {
    font-size: 11px;
    color: var(--muted);
    line-height: 1.8;
  }
  .issues summary {
    cursor: pointer;
  }
  .issues ul {
    padding-left: 17px;
  }
  .data-table-details {
    border: 1px solid var(--line);
    border-top: 0;
    padding: 20px 28px;
    border-radius: 0 0 12px 12px;
  }
  .data-table-details > summary {
    font-size: 13px;
    cursor: pointer;
  }
  .data-table-details > summary > span {
    float: right;
  }
  .table-scroll {
    max-width: 100%;
    overflow-x: auto;
  }
  .table-scroll table {
    border-collapse: collapse;
    width: 100%;
    text-align: left;
    font-size: 12px;
    margin: 12px 0;
  }
  .table-scroll caption {
    text-align: left;
    color: var(--muted);
    font-size: 11px;
    padding: 15px 0;
  }
  .table-scroll th {
    color: var(--muted);
