---
import Layout from '../../layouts/Layout.astro';
import ProjectPreview from '../../components/ProjectPreview.astro';
import { getPublishedProjects } from '../../content/projects';
import { getServices } from '../../content/services';
import { localeFromPath, translate, localizePath } from '../../i18n';
export const prerender = true;
const locale = localeFromPath(Astro.url.pathname);
const t = (fr: string, en: string, es: string) => translate(locale, fr, en, es);
const publishedProjects = getPublishedProjects(locale);
const services = getServices(locale);
---

<Layout
  title={t(
    'Réalisations — Des idées mises en pratique',
    'Work — Ideas put into practice',
    'Proyectos — Ideas llevadas a la práctica',
  )}
  description={t(
    'Explorez les démonstrateurs de Paul Berdier : automatisation de documents et transformation de données, avec leurs résultats et leurs limites explicites.',
    'Explore Paul Berdier’s demos: document automation and data transformation, with clear results and limitations.',
    'Explora las demostraciones de Paul Berdier: automatización de documentos y transformación de datos, con resultados y límites explícitos.',
  )}
>
  <div class="container page-shell" data-projects>
    <header class="page-heading">
      <p class="eyebrow">
        {t('Réalisations / Sélection', 'Work / Selected projects', 'Proyectos / Selección')}
      </p>
      <h1 data-line>
        {t('Les idées prennent', 'Ideas take', 'Las ideas toman')}
        <br />
        <em>{t('forme ici.', 'shape here.', 'forma aquí.')}</em>
      </h1>
      <p class="lede">
        {t(
          'Des interfaces que vous pouvez explorer. Des mécanismes que vous pouvez tester. Et un périmètre expliqué sans détour.',
          'Interfaces you can explore. Processes you can try. With a clear explanation of what each one does.',
          'Interfaces que puedes explorar. Procesos que puedes probar. Y un alcance explicado con claridad.',
        )}
      </p>
    </header>
    <div class="projects-toolbar">
      <div
        class="project-filters"
        role="group"
        aria-label={t('Filtrer les réalisations', 'Filter projects', 'Filtrar proyectos')}
      >
        <button type="button" data-project-filter="all" aria-pressed="true" disabled>
          {t('Tout voir', 'View all', 'Ver todos')} <span>{publishedProjects.length}</span>
        </button>
        {services.map((service) => (
          <button type="button" data-project-filter={service.slug} aria-pressed="false" disabled>
            {service.shortTitle}
          </button>
        ))}
      </div>
      <span class="toolbar-note">
        {t(
          'PROJETS PERSONNELS & DÉMONSTRATEURS',
          'PERSONAL PROJECTS & DEMOS',
          'PROYECTOS PERSONALES Y DEMOSTRACIONES',
        )}
      </span>
    </div>
    <p class="filter-status" data-project-status role="status" aria-live="polite">
      {publishedProjects.length}{' '}
      {t('démonstrateurs à explorer.', 'demos to explore.', 'demostraciones para explorar.')}
    </p>
    <div class="project-grid" data-project-grid>
      {publishedProjects.map((project) => (
        <article
          class="project-item"
          data-project-item
          data-categories={project.services.join(' ')}
          data-reveal
        >
          <a
            class="project-image-link"
            href={localizePath(project.href, locale)}
            aria-label={t('Découvrir ', 'Explore ', 'Descubrir ') + project.title}
          >
            <div class="project-image" transition:name={'project-' + project.slug}>
              <ProjectPreview project={project} />
            </div>
            <span class="project-open" aria-hidden="true">
              ↗
            </span>
          </a>
          <div class="project-meta">
            <span>{project.category}</span>
            <span>
              {project.type} / {project.number}
            </span>
          </div>
          <h2>
            <a href={localizePath(project.href, locale)}>{project.title}</a>
          </h2>
          <p>{project.summary}</p>
          <ul class="tags">
            {project.tags.map((tag) => (
              <li class="tag">{tag}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    <div class="empty-state" data-project-empty hidden>
      <span aria-hidden="true">↗</span>
      <h2>
        {t(
          'Le prochain sujet est à construire.',
          'The next project is yet to be built.',
          'El próximo proyecto está por construir.',
        )}
      </h2>
      <p>
        {t(
          'Aucune réalisation publiée dans ce domaine pour le moment. Je préfère montrer un projet vérifiable.',
          'There are no published projects in this area yet. I want to show work that you can verify.',
          'Todavía no hay proyectos publicados en esta área. Prefiero mostrar un proyecto que se pueda comprobar.',
        )}
      </p>
      <a href={localizePath('/services/intelligence-artificielle', locale)} class="text-link">
        {t('Découvrir l’approche IA', 'Explore my approach to AI', 'Descubrir mi enfoque de la IA')}{' '}
        <span aria-hidden="true">↗</span>
      </a>
    </div>
    <noscript>
      <p class="no-script-note">
        {t(
          'Tous les démonstrateurs sont affichés. Le filtrage nécessite JavaScript.',
          'All demos are shown. Filtering requires JavaScript.',
          'Se muestran todas las demostraciones. El filtrado requiere JavaScript.',
        )}
      </p>
    </noscript>
    <aside class="honesty-note">
      <span class="eyebrow">
        {t('Ce que vous regardez', 'What you are looking at', 'Qué estás viendo')}
      </span>
      <p>
        {t('Ces deux projets sont des ', 'These two projects are ', 'Estos dos proyectos son ')}
        <strong>
          {t(
            'démonstrateurs réalisés pour ce portfolio',
            'demos built for this portfolio',
            'demostraciones creadas para este portfolio',
          )}
        </strong>
        {t(
          '. Ils utilisent des données synthétiques et ne sont pas présentés comme des missions clients. Chaque étude de cas détaille ce qui fonctionne et ce qui reste hors périmètre.',
          '. They use synthetic data and are not presented as client work. Each case study explains what works and what remains outside its scope.',
          '. Utilizan datos sintéticos y no se presentan como trabajos para clientes. Cada caso explica lo que funciona y lo que queda fuera de su alcance.',
        )}
      </p>
    </aside>
  </div>
</Layout>
<style>
  .page-heading h1 em {
    font-style: normal;
    color: var(--accent);
  }
  .projects-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    padding: 25px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .project-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .project-filters button {
    background: transparent;
    color: var(--muted);
    border: 1px solid transparent;
    border-radius: 30px;
    padding: 10px 15px;
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }
  .project-filters button[aria-pressed='true'] {
    color: var(--accent-hover);
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .project-filters button:hover {
    color: var(--accent);
  }
  .project-filters button span {
    font-size: 9px;
    color: var(--accent);
    vertical-align: super;
    margin-left: 2px;
  }
  .toolbar-note {
    font: 9px monospace;
    color: var(--muted);
    letter-spacing: 0.08em;
  }
  .filter-status {
    margin: 18px 0 28px;
    font-size: 12px;
    color: var(--muted);
    min-height: 20px;
  }
  .project-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: start;
    gap: 7%;
  }
  .project-item:nth-child(2) {
    margin-top: 105px;
  }
  .project-item[hidden] {
    display: none;
  }
  .project-image-link {
    display: block;
    position: relative;
    overflow: hidden;
    color: var(--ink);
    border-radius: 12px;
  }
  .project-image {
    width: 100%;
  }
  .project-open {
    position: absolute;
    bottom: 14px;
    right: 14px;
    background: var(--ink);
    color: var(--bg);
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    font-size: 24px;
  }
  .project-meta {
    display: flex;
    justify-content: space-between;
    color: var(--muted);
    gap: 10px;
    font: 10px monospace;
    padding: 26px 0 17px;
  }
  .project-meta > span:first-child {
    color: var(--accent);
  }
  .project-item h2 {
    font-size: clamp(26px, 3vw, 40px);
    line-height: 1.13;
    letter-spacing: -0.05em;
  }
  .project-item h2 a {
    text-decoration: none;
    color: inherit;
  }
  .project-item p {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.75;
    margin: 18px 0;
    max-width: 450px;
  }
  .tags {
    padding: 0;
    margin: 20px 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }
  .honesty-note {
    margin-top: 110px;
    padding: 35px 0;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 25px;
  }
  .honesty-note p {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.8;
    margin: 0;
    max-width: 620px;
  }
  .honesty-note strong {
    color: var(--ink);
    font-weight: 500;
  }
  .empty-state {
    padding: 55px 0;
    max-width: 600px;
  }
  .empty-state[hidden] {
    display: none;
  }
  .empty-state > span {
    color: var(--accent);
    font-size: 50px;
  }
  .empty-state h2 {
    font-size: 36px;
  }
  .empty-state p,
  .no-script-note {
    color: var(--muted);
    margin: 20px 0;
  }
  @media (max-width: 950px) {
    .toolbar-note {
      display: none;
    }
    .project-grid {
      gap: 4%;
    }
  }
  @media (max-width: 767px) {
    .project-grid {
      grid-template-columns: 1fr;
      gap: 50px;
    }
    .project-item:nth-child(2) {
      margin-top: 0;
    }
    .project-filters button {
      padding: 9px 12px;
    }
    .honesty-note {
      grid-template-columns: 1fr;
      margin-top: 65px;
    }
    .project-item h2 {
      font-size: 32px;
    }
  }
</style>
