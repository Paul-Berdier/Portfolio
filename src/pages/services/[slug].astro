---
import Layout from '../../layouts/Layout.astro';
import ServiceVisual from '../../components/ServiceVisual.astro';
import { services } from '../../content/services';
import { publishedProjects } from '../../content/projects';
export const prerender = true;
export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
const { service } = Astro.props;
const relatedProjects = publishedProjects.filter((project) =>
  project.services.includes(service.slug),
);
---

<Layout title={service.title} description={service.description}>
  <div class="container page-shell">
    <a href="/services" class="text-link back-link">
      <span aria-hidden="true">←</span> Toutes les expertises
    </a>
    <header class="service-hero">
      <div>
        <p class="eyebrow">
          Expertise {service.number} / {service.shortTitle}
        </p>
        <h1 data-line>{service.promise}</h1>
        <p class="lede">{service.description}</p>
        <a class="button button-primary" href={`/contact?besoin=${service.slug}`}>
          Parler de votre projet <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="service-art">
        <ServiceVisual type={service.slug} />
        <span>MATIÈRE → SYSTÈME / {service.number}</span>
      </div>
    </header>
    <section class="editorial-section" data-reveal>
      <p class="eyebrow">Le point de départ</p>
      <div>
        <h2>Vous vous reconnaissez ?</h2>
        <ul class="needs">
          {service.needs.map((need) => (
            <li>{need}</li>
          ))}
        </ul>
      </div>
    </section>
    <section class="editorial-section" data-reveal>
      <p class="eyebrow">Ce que je construis</p>
      <div class="deliverables">
        {service.deliverables.map((item, index) => (
          <article>
            <span>0{index + 1}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
    <section class="editorial-section" data-reveal>
      <p class="eyebrow">La manière</p>
      <div>
        <h2>
          Partir du réel.
          <br />
          <em>Avancer par étapes.</em>
        </h2>
        <p class="body-copy">{service.approach}</p>
        <aside class="boundary">
          <h3>Un périmètre clair</h3>
          <p>{service.boundaries}</p>
        </aside>
      </div>
    </section>
    {relatedProjects.length > 0 && (
      <section class="editorial-section" data-reveal>
        <p class="eyebrow">Voir en pratique</p>
        <div>
          {relatedProjects.map((project) => (
            <a class="related-project" href={project.href}>
              <div>
                <small>
                  {project.type} / {project.category}
                </small>
                <h3>{project.title}</h3>
                <p>{project.summary}</p>
              </div>
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>
    )}
    <div class="final-cta" data-reveal>
      <h2>Et dans votre activité ?</h2>
      <p>Décrivons le besoin, les contraintes et la première étape utile.</p>
      <a href={`/contact?besoin=${service.slug}`} class="button button-primary">
        Faire le point ensemble <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</Layout>
<style>
  .back-link {
    margin-bottom: 55px;
  }
  .service-hero {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 7%;
    align-items: center;
    margin-bottom: 120px;
  }
  .service-hero h1 {
    font-size: clamp(40px, 5.3vw, 78px);
    letter-spacing: -0.065em;
    line-height: 1.02;
    margin: 26px 0;
  }
  .service-hero .lede {
    margin-bottom: 32px;
  }
  .service-art {
    background: var(--surface);
    padding: 30px 10px 20px;
    border: 1px solid var(--line);
    border-radius: 14px;
  }
  .service-art > span {
    display: block;
    font: 9px monospace;
    color: var(--muted);
    letter-spacing: 0.15em;
    text-align: center;
    margin-top: 20px;
  }
  .editorial-section {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 5%;
    padding: 60px 0;
    border-top: 1px solid var(--line);
  }
  .editorial-section h2 {
    font-size: clamp(31px, 4vw, 54px);
    letter-spacing: -0.05em;
  }
  .editorial-section h2 em {
    font-style: normal;
    color: var(--accent);
  }
  .needs {
    padding: 0;
    list-style: none;
    margin: 35px 0 0;
  }
  .needs li {
    border-bottom: 1px solid var(--line);
    padding: 20px 0 20px 24px;
    position: relative;
    color: var(--muted);
    line-height: 1.65;
  }
  .needs li::before {
    content: '↗';
    position: absolute;
    left: 0;
    color: var(--accent);
  }
  .deliverables article {
    display: grid;
    grid-template-columns: 35px 1fr;
    gap: 15px;
    padding: 0 0 35px;
  }
  .deliverables article > span {
    color: var(--accent);
    font-size: 11px;
    padding-top: 8px;
  }
  .deliverables p,
  .body-copy,
  .boundary p {
    color: var(--muted);
    line-height: 1.8;
    margin-top: 16px;
  }
  .body-copy {
    font-size: 18px;
    margin-bottom: 35px;
  }
  .boundary {
    border-left: 2px solid var(--accent);
    padding: 20px 25px;
    background: var(--surface);
    border-radius: 0 10px 10px 0;
  }
  .boundary h3 {
    font-size: 18px;
  }
  .boundary p {
    font-size: 14px;
    margin-bottom: 0;
  }
  .related-project {
    display: flex;
    justify-content: space-between;
    gap: 35px;
    color: inherit;
    text-decoration: none;
    padding-bottom: 35px;
  }
  .related-project small {
    display: block;
    color: var(--accent);
    margin-bottom: 15px;
  }
  .related-project p {
    color: var(--muted);
    font-size: 15px;
    margin-top: 16px;
  }
  .related-project > span {
    font-size: 30px;
  }
  .final-cta {
    padding: 70px 0 20px;
    text-align: center;
  }
  .final-cta p {
    color: var(--muted);
    margin: 25px 0;
  }
  @media (max-width: 767px) {
    .service-hero {
      grid-template-columns: 1fr;
      gap: 40px;
      margin-bottom: 70px;
    }
    .service-art {
      max-width: 540px;
    }
    .editorial-section {
      grid-template-columns: 1fr;
      gap: 25px;
      padding: 40px 0;
    }
    .back-link {
      margin-bottom: 35px;
    }
    .related-project {
      gap: 15px;
    }
    .final-cta {
      text-align: left;
    }
  }
</style>
