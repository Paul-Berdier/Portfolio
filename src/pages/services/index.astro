---
import Layout from '../../layouts/Layout.astro';
import ServiceVisual from '../../components/ServiceVisual.astro';
import { services } from '../../content/services';
export const prerender = true;
---

<Layout
  title="Expertises — Web, automatisation, data & IA"
  description="Sites et applications web, automatisation, data et IA : quatre domaines pour construire les outils qui font avancer votre activité."
>
  <div class="container page-shell">
    <header class="page-heading">
      <p class="eyebrow">Expertises / 01 — 04</p>
      <h1 data-line>
        Un besoin précis.
        <br />
        <em>La bonne réponse.</em>
      </h1>
      <p class="lede">
        Un site à créer. Des outils à relier. Des données à comprendre. Je construis la solution
        autour de votre activité.
      </p>
    </header>
    <div class="service-list">
      {services.map((service) => (
        <article class="service-row" data-service-card data-reveal>
          <div class="service-copy">
            <span class="section-label">
              {service.number} / {service.shortTitle}
            </span>
            <h2>
              <a href={`/services/${service.slug}`}>{service.title}</a>
            </h2>
            <p>{service.description}</p>
            <ul class="tags">
              {service.tags.map((tag) => (
                <li class="tag">{tag}</li>
              ))}
            </ul>
            <a class="text-link" href={`/services/${service.slug}`}>
              Explorer cette expertise <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class="service-art">
            <ServiceVisual type={service.slug} />
          </div>
        </article>
      ))}
    </div>
    <section class="cross-section" data-reveal>
      <p class="eyebrow">Le fil commun</p>
      <div>
        <h2>
          Les sujets se croisent.
          <br />
          <em>Le projet reste cohérent.</em>
        </h2>
        <p>
          Une application peut automatiser un processus, exploiter des données et intégrer une
          recherche documentaire. Je garde une vue d’ensemble, avec un seul point de contact.
        </p>
        <a href="/contact" class="button button-primary">
          Parler de votre projet <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </div>
</Layout>
<style>
  .page-heading h1 em,
  h2 em {
    color: var(--accent);
    font-style: normal;
  }
  .service-row {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 9%;
    padding: 68px 0;
    border-top: 1px solid var(--line);
    align-items: center;
  }
  .service-row:nth-child(even) .service-art {
    background: var(--surface-raised);
  }
  .service-copy h2 {
    font-size: clamp(30px, 4.5vw, 59px);
    line-height: 1.05;
    letter-spacing: -0.055em;
    margin: 22px 0;
  }
  .service-copy h2 a {
    color: inherit;
    text-decoration: none;
  }
  .service-copy p {
    max-width: 460px;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.65;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    padding: 0;
    gap: 7px;
    margin: 24px 0 32px;
    list-style: none;
  }
  .service-art {
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 18px;
    border-radius: 14px;
  }
  .cross-section {
    margin-top: 100px;
    display: grid;
    grid-template-columns: 1fr 2fr;
    padding-top: 50px;
    border-top: 1px solid var(--line);
  }
  .cross-section p:not(.eyebrow) {
    color: var(--muted);
    max-width: 590px;
    line-height: 1.8;
    margin: 26px 0;
  }
  .cross-section h2 {
    font-size: clamp(34px, 4.5vw, 60px);
  }
  @media (max-width: 767px) {
    .service-row {
      grid-template-columns: 1fr;
      gap: 30px;
      padding: 45px 0;
    }
    .service-art {
      max-width: 580px;
    }
    .cross-section {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-top: 60px;
    }
  }
</style>
